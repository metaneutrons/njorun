{
  "description": "Install messages of decision D7, checked by Rust and Python: install (HA to tablet), install_result, install_progress and install_outcome (tablet to HA). 'valid' messages are accepted; every 'invalid' entry is rejected. Shape only: expiry, duplicates, busy, compatibility and slot size are decisions of the tablet and are tested there. Messages carry exactly the listed fields plus 'type'.",
  "reject_reasons": [
    "expired",
    "duplicate",
    "busy",
    "incompatible",
    "too_large",
    "malformed"
  ],
  "stages": [
    "download",
    "verify",
    "write",
    "reboot"
  ],
  "outcome_states": [
    "installed",
    "rolled_back"
  ],
  "channels": [
    "stable",
    "beta"
  ],
  "limits": {
    "install_id_bytes": 128,
    "version_chars": 32,
    "url_chars": 512,
    "token_min_chars": 32,
    "token_max_chars": 128,
    "command_ttl_seconds": 300,
    "result_timeout_seconds": 15,
    "outcome_window_seconds": 1800,
    "slot_bytes": 8388608,
    "progress_min_interval_ms": 1000
  },
  "ha_origin": "https://ha.local:8123",
