import { VirtualKeyboard } from "virtual_keyboard.slint";
import { Palette } from "palette.slint";
import "../../../assets/fonts/Inter-Regular.ttf";
import "../../../assets/fonts/Inter-Medium.ttf";
import "../../../assets/fonts/Inter-SemiBold.ttf";

export enum EntityIcon {
    Lightbulb,
    Power,
    Play,
    Thermometer,
    Sensor,
    BinarySensor,
    Fan,
    Lock,
    LockOpen,
    MediaPlayer,
    Camera,
    Shield,
    Script,
    Automation,
    ToggleSwitch,
    Button,
    Number,
    Select,
    Cover,
    Climate,
    Water,
    Robot,
    Calendar,
    Weather,
    Presence,
    Timer,
    Update,
    Voice,
    Remote,
    Text,
}

global Icons {
    pure public function control(key: string) -> image {
        return key == "play" ? @image-url("../../../assets/icons/play.svg")
            : key == "pause" ? @image-url("../../../assets/icons/pause.svg")
            : key == "next" ? @image-url("../../../assets/icons/skip-next.svg")
            : key == "previous" ? @image-url("../../../assets/icons/skip-previous.svg")
            : key == "power" ? @image-url("../../../assets/icons/power.svg")
            : key == "stop" ? @image-url("../../../assets/icons/media-stop.svg")
            : key == "mute" ? @image-url("../../../assets/icons/media-muted.svg")
            : key == "volume" ? @image-url("../../../assets/icons/speaker.svg")
            : key == "shuffle" ? @image-url("../../../assets/icons/media-shuffle.svg")
            : key == "repeat" ? @image-url("../../../assets/icons/media-repeat.svg")
            : key == "browse" ? @image-url("../../../assets/icons/media-library.svg")
            : key == "search" ? @image-url("../../../assets/icons/media-search.svg")
            : key == "group" ? @image-url("../../../assets/icons/media-group.svg")
            : key == "queue" ? @image-url("../../../assets/icons/media-queue.svg")
            : @image-url("../../../assets/icons/gesture-tap-button.svg");
    }
    pure public function room(key: string) -> image {
        return key == "sofa" ? @image-url("../../../assets/icons/room-sofa.svg")
            : key == "kitchen" ? @image-url("../../../assets/icons/room-kitchen.svg")
            : key == "bed" ? @image-url("../../../assets/icons/room-bed.svg")
            : key == "desk" ? @image-url("../../../assets/icons/room-desk.svg")
            : key == "bath" ? @image-url("../../../assets/icons/room-bath.svg")
            : key == "garage" ? @image-url("../../../assets/icons/room-garage.svg")
            : key == "garden" ? @image-url("../../../assets/icons/room-garden.svg")
            : @image-url("../../../assets/icons/home-outline.svg");
    }
    pure public function source(icon: EntityIcon) -> image {
        return icon == EntityIcon.Lightbulb ? @image-url("../../../assets/icons/lightbulb.svg")
            : icon == EntityIcon.Power ? @image-url("../../../assets/icons/power.svg")
            : icon == EntityIcon.Play ? @image-url("../../../assets/icons/scene-sparkle.svg")
            : icon == EntityIcon.Thermometer ? @image-url("../../../assets/icons/thermometer.svg")
            : icon == EntityIcon.Sensor ? @image-url("../../../assets/icons/information-outline.svg")
            : icon == EntityIcon.BinarySensor ? @image-url("../../../assets/icons/sensor-presence.svg")
            : icon == EntityIcon.Fan ? @image-url("../../../assets/icons/fan.svg")
            : icon == EntityIcon.Lock ? @image-url("../../../assets/icons/lock.svg")
            : icon == EntityIcon.LockOpen ? @image-url("../../../assets/icons/lock-open-variant.svg")
            : icon == EntityIcon.MediaPlayer ? @image-url("../../../assets/icons/speaker.svg")
            : icon == EntityIcon.Camera ? @image-url("../../../assets/icons/camera.svg")
            : icon == EntityIcon.Shield ? @image-url("../../../assets/icons/shield-home.svg")
            : icon == EntityIcon.Script ? @image-url("../../../assets/icons/script-text.svg")
            : icon == EntityIcon.Automation ? @image-url("../../../assets/icons/robot.svg")
            : icon == EntityIcon.ToggleSwitch ? @image-url("../../../assets/icons/toggle-switch.svg")
            : icon == EntityIcon.Button ? @image-url("../../../assets/icons/gesture-tap-button.svg")
            : icon == EntityIcon.Number ? @image-url("../../../assets/icons/numeric.svg")
            : icon == EntityIcon.Cover ? @image-url("../../../assets/icons/entity-cover.svg")
            : icon == EntityIcon.Climate ? @image-url("../../../assets/icons/entity-climate.svg")
            : icon == EntityIcon.Water ? @image-url("../../../assets/icons/entity-water.svg")
            : icon == EntityIcon.Robot ? @image-url("../../../assets/icons/entity-robot.svg")
            : icon == EntityIcon.Calendar ? @image-url("../../../assets/icons/entity-calendar.svg")
            : icon == EntityIcon.Weather ? @image-url("../../../assets/icons/entity-weather.svg")
            : icon == EntityIcon.Presence ? @image-url("../../../assets/icons/entity-presence.svg")
            : icon == EntityIcon.Timer ? @image-url("../../../assets/icons/entity-timer.svg")
            : icon == EntityIcon.Update ? @image-url("../../../assets/icons/entity-update.svg")
            : icon == EntityIcon.Voice ? @image-url("../../../assets/icons/entity-voice.svg")
            : icon == EntityIcon.Remote ? @image-url("../../../assets/icons/entity-remote.svg")
            : icon == EntityIcon.Text ? @image-url("../../../assets/icons/entity-text.svg")
            : @image-url("../../../assets/icons/format-list-bulleted.svg");
    }
}

export struct WifiItem {
    name: string,
    signal: int,
    secured: bool,
}

export struct InstanceItem {
    name: string,
    endpoint: string,
}

export struct TileItem {
    kind: string,
    action-enabled: bool,
    entity-id: string,
    name: string,
    value: string,
    icon: EntityIcon,
    active: bool,
    pending: bool,
    failed: bool,
    unavailable: bool,
    stale: bool,
    command-enabled: bool,
}

export struct RoomItem {
    icon: string,
    id: string,
    name: string,
    summary: string,
}

export struct ActionItem {
    key: string,
    label: string,
}

export struct InputItem {
    key: string,
    label: string,
    kind: string,
    value: string,
    options: [string],
    required: bool,
}

export struct ControlItem {
    key: string,
    label: string,
    kind: string,
    value: string,
    options: [string],
    minimum: float,
    maximum: float,
    step: float,
    unit: string,
    inputs: [InputItem],
    enabled: bool,
    dangerous: bool,
    icon-key: string,
    group: string,
}

export struct ResultItem {
    title: string,
    subtitle: string,
    action: string,
    argument: string,
    secondary-action: string,
    secondary-argument: string,
}

export struct DetailsItem {
    entity-id: string,
    name: string,
    value: string,
    update-time: string,
    reason: string,
    attributes: string,
    icon: EntityIcon,
    unavailable: bool,
    can-toggle: bool,
    controls-enabled: bool,
    // "none", "slider", "options", "lock", "media", "alarm", "camera" or "automation".
    control: string,
    slider-action: string,
    slider-min: float,
    slider-max: float,
    slider-step: float,
    slider-value: float,
    slider-unit: string,
    options: [string],
    selected-option: string,
    locked: bool,
    playing: bool,
    has-volume: bool,
    needs-code: bool,
    actions: [ActionItem],
    camera-image: image,
    camera-loading: bool,
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <string> accessible-name: root.label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <bool> dark-mode;
    in property <image> icon;
    callback clicked();

    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    height: 60px;
    min-width: 72px;
    horizontal-stretch: 1;
    border-radius: 18px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.danger && press.pressed ? Palette.danger-surface-pressed
        : press.pressed ? Palette.surface-pressed
        : root.danger ? Palette.danger-surface
        : root.primary ? Palette.selected-surface : Palette.soft;
    border-width: 1px;
    border-color: Palette.border;
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        padding-left: 14px;
        padding-right: 14px;
        if root.icon.width > 0: Image {
            source: root.icon;
            width: 26px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            colorize: Palette.accent;
        }
        if root.label != "": Text {
            text: root.label;
            color: root.danger ? Palette.on-danger : Palette.text;
            font-size: 18px;
            font-weight: 650;
            vertical-alignment: center;
        }
    }
    press := TouchArea { clicked => { if root.enabled { root.clicked(); } } }
}

component LevelSlider inherits Rectangle {
    in property <string> label: "Value";
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <float> value;
    in property <string> unit;
    in property <bool> dark-mode;
    in property <bool> enabled: true;
    /// The principal value in a detail sheet is larger; secondary sliders such as media volume
    /// stay compact.
    in property <bool> prominent: false;
    in property <int> decimals: 2;
    in property <bool> time-display: false;
    callback committed(float);
    accessible-role: slider;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-value: root.shown;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-set-value(v) => { if root.enabled && v.is-float() { root.commit-accessible(v.to-float()); } }
    accessible-action-increment => { if root.enabled { root.commit-accessible(root.shown + root.step); } }
    accessible-action-decrement => { if root.enabled { root.commit-accessible(root.shown - root.step); } }
    function commit-accessible(value: float) {
        root.drag-value = root.snap(Math.clamp(value, root.minimum, root.maximum));
        root.holding = true;
        root.committed(root.drag-value);
    }

    private property <bool> dragging: false;
    private property <bool> holding: false;
    private property <float> drag-value: 0;
    private property <float> shown: (root.dragging || root.holding) ? root.drag-value : root.value;
    private property <float> fraction: root.maximum > root.minimum
        ? Math.clamp((root.shown - root.minimum) / (root.maximum - root.minimum), 0, 1) : 0;

    height: root.prominent ? 118px : 96px;
    opacity: root.enabled ? 1 : 0.45;
    changed value => { root.holding = false; }
    Timer {
        interval: 2500ms;
        running: root.holding && !root.dragging;
        triggered => { root.holding = false; }
    }

    function pick(x: length) {
        if (root.maximum <= root.minimum) { return; }
        root.drag-value = root.snap(root.minimum + Math.clamp(x / track.width, 0, 1) * (root.maximum - root.minimum));
    }
    pure function snap(raw: float) -> float {
        return Math.clamp(root.minimum + Math.round((raw - root.minimum) / root.step) * root.step, root.minimum, root.maximum);
    }

    VerticalLayout {
        spacing: 12px;
        Text {
            text: root.time-display
                ? Math.floor(root.shown / 60) + ":" + (Math.mod(Math.floor(root.shown), 60) < 10 ? "0" : "") + Math.mod(Math.floor(root.shown), 60)
                    + " / " + Math.floor(root.maximum / 60) + ":" + (Math.mod(Math.floor(root.maximum), 60) < 10 ? "0" : "") + Math.mod(Math.floor(root.maximum), 60)
                : (Math.round(root.shown * Math.pow(10, root.decimals)) / Math.pow(10, root.decimals)) + (root.unit == "" ? "" : " " + root.unit);
            color: Palette.text;
            font-size: root.prominent ? 44px : 26px;
            font-weight: 650;
        }
        track := Rectangle {
            height: 44px;
            border-radius: 22px;
            background: Palette.inactive-surface;
            Rectangle {
                x: 0px;
                width: max(44px, parent.width * root.fraction);
                height: parent.height;
                border-radius: 22px;
                background: Palette.accent-fill;
            }
            Rectangle {
                x: max(0px, min(parent.width - self.width, parent.width * root.fraction - self.width / 2));
                y: 4px;
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: #ffffff;
                border-width: 1px;
                border-color: Palette.accent-line;
            }
            TouchArea {
                enabled: root.enabled;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.dragging = true;
                        root.pick(self.mouse-x);
                    } else if event.kind == PointerEventKind.up {
                        if root.dragging {
                            root.dragging = false;
                            root.holding = true;
                            root.committed(root.drag-value);
                        }
                    } else if event.kind == PointerEventKind.cancel {
                        root.dragging = false;
                    }
                }
                moved => { if root.dragging { root.pick(self.mouse-x); } }
            }
        }
    }
}

component OptionRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <bool> dark-mode;
    callback chosen();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if root.enabled { root.chosen(); } }
    accessible-enabled: root.enabled;
    opacity: root.enabled ? 1 : 0.45;
    height: 58px;
    border-radius: 16px;
    background: press.pressed ? Palette.surface-pressed
        : root.selected ? Palette.selected-surface : Palette.surface-alt;
    border-width: root.selected ? 1.5px : 1px;
    border-color: root.selected ? Palette.accent-line : Palette.border;
    Text {
        x: 18px;
        width: parent.width - 36px;
        text: root.label;
        color: Palette.text;
        font-size: 20px;
        font-weight: root.selected ? 650 : 500;
        vertical-alignment: center;
        overflow: elide;
    }
    press := TouchArea { enabled: root.enabled; clicked => { root.chosen(); } }
}

component CodeKeypad inherits Rectangle {
    in property <bool> dark-mode;
    in-out property <string> code;
    private property <int> digits: root.code.character-count;
    height: 4 * 64px + 3 * 8px + 50px;

    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            height: 42px;
            alignment: center;
            spacing: 10px;
            for slot[index] in 16: Rectangle {
                y: (parent.height - self.height) / 2;
                width: index < root.digits ? 16px : 0px;
                height: 16px;
                border-radius: 8px;
                background: Palette.text;
            }
        }
        for row in [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"], ["C", "0", ""]]: HorizontalLayout {
            spacing: 8px;
            for key in row: Rectangle {
                height: 64px;
                horizontal-stretch: 1;
                border-radius: 16px;
                background: key == "" ? transparent : key-press.pressed ? Palette.surface-pressed : Palette.soft;
                Text {
                    text: key;
                    color: Palette.text;
                    font-size: 28px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                key-press := TouchArea {
                    clicked => {
                        if key == "C" {
                            root.code = "";
                        } else if key != "" && root.code.character-count < 16 {
                            root.code = root.code + key;
                        }
                    }
                }
            }
        }
    }
}

component ChoiceButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> dark-mode;
    callback clicked();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    height: 50px;
    horizontal-stretch: 1;
    border-radius: 14px;
    background: press.pressed ? Palette.surface-pressed
        : root.selected ? Palette.selected-surface : Palette.surface-alt;
    border-width: root.selected ? 1.5px : 1px;
    border-color: root.selected ? Palette.accent-line : Palette.border;
    Text {
        text: root.label;
        color: Palette.text;
        font-size: 15px;
        font-weight: root.selected ? 650 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    press := TouchArea { clicked => { root.clicked(); } }
}

component DetailField inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> dark-mode;

    height: 78px;
    horizontal-stretch: 1;
    border-radius: 16px;
    background: Palette.surface-alt;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 11px;
        padding-bottom: 11px;
        spacing: 5px;
        Text {
            text: root.label;
            color: Palette.muted;
            font-size: 17px;
            font-weight: 550;
        }
        Text {
            text: root.value;
            color: Palette.text;
            font-size: 20px;
            font-weight: 550;
            overflow: elide;
        }
    }
}

component EntityControlCard inherits Rectangle {
    in property <ControlItem> item;
    in property <bool> german;
    in property <bool> allow-actions: true;
    in property <float> media-position: -1;
    in-out property <[InputItem]> fields: item.inputs;
    private property <bool> editing: false;
    private property <bool> expanded: false;
    callback action(string, string);
    callback submit(string, [InputItem]);
    callback virtual-key(string);
    callback editing-changed(bool);
    background: transparent;
    preferred-height: content.preferred-height;
    content := VerticalLayout {
        spacing: 10px;
        if item.kind == "slider": VerticalLayout {
            spacing: 8px;
            if item.key != "media_seek": Text { text: item.label; color: Palette.text; font-size: 22px; font-weight: 600; }
            LevelSlider {
                enabled: item.enabled && root.allow-actions;
                label: item.label;
                minimum: item.minimum; maximum: item.maximum; step: item.step;
                value: item.key == "media_seek" && root.media-position >= 0 ? root.media-position : item.value.to-float(); unit: item.unit;
                time-display: item.key == "media_seek";
                decimals: item.step < 0.001 ? 6 : item.step < 0.01 ? 3 : 2;
                committed(value) => { root.action(item.key, value); }
            }
        }
        if item.group == "explanation": Text {
            text: item.label; color: Palette.muted; font-size: 20px; wrap: word-wrap;
        }
        if item.group != "explanation" && (item.kind == "button" || item.kind == "toggle"): ActionButton {
            label: item.kind == "toggle" ? item.label + (item.value == "true" ? (root.german ? " · Ein" : " · On") : (root.german ? " · Aus" : " · Off")) : item.label;
            icon: Icons.control(item.icon-key);
            enabled: item.enabled && root.allow-actions;
            danger: item.dangerous;
            primary: item.kind == "toggle" && item.value == "true";
            clicked => { root.action(item.key, item.kind == "toggle" ? (item.value == "true" ? "false" : "true") : item.value); }
        }
        if item.kind == "select": VerticalLayout {
            spacing: 8px;
            ActionButton {
                label: item.label + (item.value == "" ? "" : " · " + item.value);
                icon: @image-url("../../../assets/icons/chevron-right.svg");
                enabled: item.enabled && root.allow-actions;
                clicked => { root.expanded = !root.expanded; root.editing-changed(root.expanded); }
            }
            if root.expanded: VerticalLayout {
                spacing: 8px;
                for option in item.options: OptionRow {
                    label: option; selected: option == item.value; enabled: item.enabled && root.allow-actions;
                    chosen => { root.action(item.key, option); root.expanded = false; root.editing-changed(false); }
                }
            }
        }
        if item.kind == "form" && item.group != "explanation": ActionButton {
            label: item.label; icon: Icons.control(item.icon-key); enabled: item.enabled && root.allow-actions; danger: item.dangerous;
            clicked => { root.expanded = !root.expanded; root.editing-changed(root.expanded); }
        }
        if item.kind == "form" && root.expanded: VerticalLayout {
            spacing: 12px;
            for field[index] in root.fields: VerticalLayout {
                spacing: 6px;
                Text { text: field.label + (field.required ? " *" : ""); color: Palette.muted; font-size: 18px; }
                if field.kind == "select": VerticalLayout {
                    spacing: 6px;
                    for option in field.options: OptionRow {
                        label: option; selected: option == field.value; enabled: item.enabled && root.allow-actions;
                        chosen => { root.fields[index].value = option; }
                    }
                }
                if field.kind == "toggle": ActionButton {
                    label: field.value == "" ? (root.german ? "Nicht gesetzt" : "Not set") : field.value == "true" ? (root.german ? "Ja" : "Yes") : (root.german ? "Nein" : "No");
                    enabled: item.enabled && root.allow-actions;
                    clicked => { root.fields[index].value = field.value == "true" ? "false" : field.value == "false" && !field.required ? "" : "true"; }
                }
                if field.kind != "select" && field.kind != "toggle": Rectangle {
                    height: 58px; border-radius: 12px;
                    background: Palette.surface-alt;
                    border-width: 1px; border-color: field-input.has-focus ? Palette.accent : Palette.border;
                    field-input := TextInput {
                        x: 14px; y: 8px; width: parent.width - 28px; height: parent.height - 16px;
                        text: field.value;
                        enabled: item.enabled && root.allow-actions;
                        color: Palette.text; font-size: 22px;
                        input-type: field.kind == "password" ? InputType.password : InputType.text;
                        single-line: true;
                        edited => { root.fields[index].value = self.text; }
                        changed has-focus => {
                            if self.has-focus { root.editing = true; root.editing-changed(true); }
                        }
                    }
                }
            }
            if root.editing: VirtualKeyboard {
                height: 252px;
                german: root.german;
                key-pressed(key) => {
                    if key == "submit" { root.editing = false; }
                    else { root.virtual-key(key); }
                }
            }
            ActionButton {
                label: root.german ? "Anwenden" : "Apply";
                enabled: item.enabled && root.allow-actions;
                danger: item.dangerous;
                primary: !item.dangerous;
                clicked => { root.editing = false; root.submit(item.key, root.fields); root.expanded = false; root.editing-changed(false); }
            }
        }
    }
}

component RoomShortcut inherits Rectangle {
    in property <RoomItem> item;
    in property <bool> dark-mode;
    in property <bool> selected;
    in property <bool> compact;
    callback chosen();
    callback activity();

    accessible-role: button;
    accessible-label: item.name;
    accessible-description: item.summary;
    accessible-action-default => { root.chosen(); }
    height: 58px;
    border-radius: compact ? 16px : 22px;
    background: touch-area.pressed ? Palette.surface-pressed : selected
        ? Palette.selected-surface : Palette.surface;
    border-width: selected ? 1.5px : 1px;
    border-color: selected
        ? Palette.accent-line : Palette.border;

    HorizontalLayout {
        padding: compact ? 10px : 16px;
        padding-top: compact ? 4px : 12px;
        padding-bottom: compact ? 4px : 12px;
        spacing: 12px;
        Rectangle {
            width: compact ? 25px : 52px;
            room-icon := Rectangle {
                width: compact ? 25px : 52px;
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: compact ? 0px : 16px;
                background: compact ? transparent : Palette.soft;
                Image {
                    source: Icons.room(item.icon);
                    width: compact ? 25px : 38px;
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: root.selected ? Palette.accent : Palette.icon;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: compact ? 2px : 7px;
            Text {
                text: item.name;
                color: Palette.text;
                font-size: compact ? 20px : 26px;
                wrap: word-wrap;
                max-lines: 2;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            if !compact: Text {
                text: item.summary;
                color: Palette.muted;
                font-size: 20px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    touch-area := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.activity(); }
        }
        clicked => { root.chosen(); }
    }
}

component EntityTile inherits Rectangle {
    in property <TileItem> item;
    in property <bool> dark-mode;
    in property <bool> german;
    callback activate();
    callback request-details();
    callback activity();

    private property <string> pressed-id: "";
    private property <bool> hold-cancelled: false;
    private property <bool> hold-consumed: false;
    private property <bool> tap-cancelled: false;
    private property <bool> expanded-status: item.pending || item.failed || item.stale || item.unavailable;

    accessible-role: button;
    accessible-label: item.name;
    accessible-description: item.value;
    accessible-action-default => {
        if item.kind == "scene" && item.action-enabled { root.activate(); } else { root.request-details(); }
    }
    private property <color> icon-color: item.active ? Palette.accent : Palette.icon;
    border-radius: 20px;
    border-width: 1px;
    border-color: item.failed ? Palette.error : item.active && item.kind == "control" ? Palette.accent-line : Palette.border;
    background: touch-area.pressed && !root.tap-cancelled
        ? Palette.surface-pressed : item.active && item.kind == "control" ? Palette.active-surface : Palette.surface;

    HorizontalLayout {
        padding: 16px;
        // Match the leading inset: 16 px edge + 56 px action + 12 px text gap.
        padding-right: 84px;
        spacing: 12px;
        Rectangle {
            width: 52px;
            Rectangle {
                width: 52px;
                height: 52px;
                y: (parent.height - self.height) / 2;
                border-radius: 16px;
                background: item.active ? Palette.active-surface : Palette.inactive-surface;
                Image {
                    source: Icons.source(item.icon);
                    width: 34px;
                    height: 34px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: root.icon-color;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: item.kind == "measurement" ? 2px : 5px;
            Text {
                text: item.name;
                color: Palette.text;
                font-size: item.kind == "measurement" ? 20px : 24px;
                wrap: word-wrap;
                max-lines: root.expanded-status ? 1 : 2;
                font-weight: item.kind == "measurement" ? 400 : 600;
                vertical-alignment: center;
                overflow: elide;
                width: 100%;
            }
            HorizontalLayout {
                spacing: 8px;
                if item.kind != "measurement": Rectangle {
                    width: 10px;
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 5px;
                        background: item.failed
                            ? Palette.error
                            : item.pending
                                ? Palette.warning
                                : item.active
                                    ? Palette.accent : Palette.subtle;
                    }
                }
                Text {
                    text: item.value;
                    color: item.failed
                        ? Palette.error
                        : item.pending
                            ? Palette.warning
                            : item.unavailable || item.stale
                                ? Palette.subtle : Palette.muted;
                    font-size: item.kind == "measurement" && !item.unavailable && !item.stale && !item.failed && !item.pending ? 32px : 20px;
                    font-weight: item.kind == "measurement" ? 600 : 400;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    max-lines: root.expanded-status && item.kind != "measurement" ? 2 : 1;
                    overflow: elide;
                    min-width: 0px;
                    horizontal-stretch: 1;
                }
            }
        }
    }

    touch-area := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.pressed-id = item.entity-id;
                root.hold-cancelled = false;
                root.hold-consumed = false;
                root.tap-cancelled = false;
                root.activity();
            } else if event.kind == PointerEventKind.cancel {
                root.hold-cancelled = true;
                root.tap-cancelled = true;
            }
        }
        moved => {
            if abs(self.mouse-x - self.pressed-x) > 16px || abs(self.mouse-y - self.pressed-y) > 16px {
                root.hold-cancelled = true;
                root.tap-cancelled = true;
                root.activity();
            }
        }
        clicked => {
            if root.hold-consumed {
                root.hold-consumed = false;
            } else if !root.tap-cancelled && root.pressed-id == item.entity-id {
                if item.kind == "scene" && item.action-enabled { root.activate(); } else { root.request-details(); }
            }
            root.tap-cancelled = false;
            root.pressed-id = "";
        }
    }

    Timer {
        interval: 620ms;
        running: touch-area.pressed && root.pressed-id == item.entity-id && !root.hold-cancelled && !root.hold-consumed;
        triggered => {
            if !root.hold-cancelled {
                root.hold-consumed = true;
                root.request-details();
            }
        }
    }

    Rectangle {
        accessible-role: button;
        accessible-label: (item.action-enabled && item.kind == "control"
            ? (item.active ? (root.german ? "Ausschalten: " : "Turn off: ") : (root.german ? "Einschalten: " : "Turn on: "))
            : item.action-enabled && item.kind == "media" ? (item.active ? "Pause: " : (root.german ? "Wiedergabe: " : "Play: "))
            : item.action-enabled && item.kind == "scene" ? (root.german ? "Ausführen: " : "Run: ")
            : (root.german ? "Details zu " : "Details for ")) + item.name;
        accessible-action-default => {
            if item.action-enabled && (item.kind == "control" || item.kind == "scene" || item.kind == "media") { root.activate(); }
            else { root.request-details(); }
        }
        background: info-touch.pressed ? Palette.surface-pressed
            : item.action-enabled && (item.kind == "control" || item.kind == "scene" || item.kind == "media") ? Palette.soft : transparent;
        x: parent.width - self.width - 16px;
        y: (parent.height - self.height) / 2;
        width: 56px;
        height: 56px;
        border-radius: 16px;
        Image {
            source: item.action-enabled && item.kind == "control" ? @image-url("../../../assets/icons/power.svg")
                : item.action-enabled && item.kind == "media" ? (item.active ? @image-url("../../../assets/icons/pause.svg") : @image-url("../../../assets/icons/play.svg"))
                : item.action-enabled && item.kind == "scene" ? @image-url("../../../assets/icons/play.svg")
                : @image-url("../../../assets/icons/chevron-right.svg");
            width: 28px;
            height: 28px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: item.action-enabled ? Palette.accent : Palette.icon;
        }
        info-touch := TouchArea {
            clicked => {
                if item.action-enabled && (item.kind == "control" || item.kind == "scene" || item.kind == "media") { root.activate(); }
                else { root.request-details(); }
            }
        }
    }
}

// A step button of the page indicator. It keeps a touch target of at least 48 px.
component PagerButton inherits Rectangle {
    in property <string> label;
    in property <bool> forward;
    in property <bool> enabled: true;
    in property <bool> dark-mode;
    callback chosen();

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.chosen(); } }
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: !root.enabled ? transparent
        : pager-touch.pressed ? Palette.surface-pressed : Palette.soft;
    Image {
        source: root.forward
            ? @image-url("../../../assets/icons/chevron-right.svg")
            : @image-url("../../../assets/icons/chevron-left.svg");
        width: 32px;
        height: 32px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: Palette.accent;
        opacity: root.enabled ? 1 : 0.3;
    }
    pager-touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.chosen(); }
    }
}

// Tiles in pages, as many rows as fit the height. Horizontal swiping, the arrows or the dots move
// between pages, the dots and the counter show where you are, and a strip of the neighbouring
// pages stays visible at the edges as the hint that there is more. There is no vertical scrolling.
// A grid that fits shows no indicator and no strip. Tiles are placed by the grids that inherit
// this one with `item-x` and `item-y`; they appear where `@children` stands.
component CardGrid inherits Rectangle {
    in property <int> item-count;
    in property <length> gap;
    in property <bool> dark-mode;
    in property <bool> german;
    // As many columns as leave each tile at least 320 px, at most three. A narrow window, or a
    // large scale factor, therefore gets fewer columns.
    out property <int> columns: max(1, min(3, Math.floor((self.width + root.gap) / (320px + root.gap))));
    // Changes when the grid shows other content (another room); the grid then starts on page 1.
    in property <int> context;
    callback activity();
    out property <length> row-height: 120px;
    // The page that is shown, 0 based.
    out property <int> page: 0;
    out property <int> page-count: root.paged ? max(1, Math.ceil(root.item-count / root.per-page)) : 1;
    out property <length> cell-width: (self.width - 2 * root.margin - (root.columns - 1) * root.gap) / root.columns;

    property <length> indicator-height: 64px;
    // How much of the next and the previous page stays visible at the edge.
    property <length> peek: 22px;
    property <int> rows-unpaged: max(1, Math.floor((self.height + root.gap) / (root.row-height + root.gap)));
    property <bool> paged: root.item-count > root.columns * root.rows-unpaged;
    property <int> rows: root.paged
        ? max(1, Math.floor((self.height - root.indicator-height + root.gap) / (root.row-height + root.gap)))
        : root.rows-unpaged;
    property <int> per-page: root.columns * root.rows;
    property <length> margin: root.page-count > 1 ? root.gap + root.peek : 0px;
    // The distance between the starts of two pages.
    property <length> pitch: self.width - 2 * root.margin + root.gap;
    property <length> offset: 0px;
    property <bool> dragging: false;

    horizontal-stretch: 1;
    vertical-stretch: 1;
    animate offset { duration: root.dragging || Palette.reduced-motion ? 0ms : 160ms; easing: ease-out; }

    public pure function item-x(index: int) -> length {
        return root.margin + root.offset + Math.floor(index / root.per-page) * root.pitch
            + Math.mod(index, root.columns) * (root.cell-width + root.gap);
    }
    public pure function item-y(index: int) -> length {
        return Math.floor(Math.mod(index, root.per-page) / root.columns) * (root.row-height + root.gap);
    }
    // Only the pages at and beside the shown one are drawn.
    public pure function near(index: int) -> bool {
        return Math.abs(Math.floor(index / root.per-page) - root.page) <= 1;
    }
    // Past the first or the last page the content follows the finger only a little.
    pure function resisted(moved: length) -> length {
        return Math.clamp(
            ((root.page == 0 && moved > 0px) || (root.page == root.page-count - 1 && moved < 0px)) ? moved / 4 : moved,
            -root.pitch, root.pitch);
    }
    function go(target: int) {
        root.dragging = false;
        root.page = Math.clamp(target, 0, root.page-count - 1);
        root.offset = -root.page * root.pitch;
    }
    function step(delta: int) {
        root.go(root.page + delta);
        root.activity();
    }
    changed pitch => { root.offset = -root.page * root.pitch; }
    changed page-count => { if root.page >= root.page-count { root.go(root.page-count - 1); } }
    changed context => { root.go(0); }

    SwipeGestureHandler {
        enabled: root.page-count > 1;
        handle-swipe-left: true;
        handle-swipe-right: true;
        moved => {
            root.dragging = true;
            root.offset = -root.page * root.pitch + root.resisted(self.current-position.x - self.pressed-position.x);
        }
        swiped => {
            // A swipe of a fifth of a page turns it.
            if self.current-position.x < self.pressed-position.x - root.pitch / 5 {
                root.step(1);
            } else if self.current-position.x > self.pressed-position.x + root.pitch / 5 {
                root.step(-1);
            } else {
                root.go(root.page);
            }
        }
        cancelled => { root.go(root.page); }
        Rectangle {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.page-count > 1 ? root.height - root.indicator-height : root.height;
            clip: true;
            @children
        }
    }

    if root.page-count > 1: HorizontalLayout {
        y: root.height - root.indicator-height;
        height: root.indicator-height;
        alignment: center;
        spacing: 12px;
        PagerButton {
            label: root.german ? "Vorherige Seite" : "Previous page";
            enabled: root.page > 0;
            dark-mode: root.dark-mode;
            chosen => { root.step(-1); }
        }
        if root.page-count <= 5 && root.width >= 440px: HorizontalLayout {
            alignment: center;
            for number in root.page-count: Rectangle {
                width: 48px;
                accessible-role: button;
                accessible-label: "\{number + 1} / \{root.page-count}";
                accessible-action-default => { root.go(number); root.activity(); }
                Rectangle {
                    width: number == root.page ? 12px : 9px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: number == root.page ? Palette.accent : Palette.dot-off;
                }
                TouchArea { clicked => { root.go(number); root.activity(); } }
            }
        }
        Text {
            text: "\{root.page + 1} / \{root.page-count}";
            color: Palette.accent;
            font-size: 16px;
            font-weight: 650;
            vertical-alignment: center;
        }
        PagerButton {
            label: root.german ? "Nächste Seite" : "Next page";
            forward: true;
            enabled: root.page < root.page-count - 1;
            dark-mode: root.dark-mode;
            chosen => { root.step(1); }
        }
    }
}

component EntityGrid inherits CardGrid {
    in property <[TileItem]> items;
    callback activate(string);
    callback request-details(string);
    item-count: items.length;
    for tile[index] in root.items: EntityTile {
        width: root.cell-width;
        height: root.row-height;
        x: root.item-x(index);
        y: root.item-y(index);
        visible: root.near(index);
        item: tile;
        dark-mode: root.dark-mode;
        german: root.german;
        activate => { root.activate(tile.entity-id); }
        request-details => { root.request-details(tile.entity-id); }
        activity => { root.activity(); }
    }
}

component RoomGrid inherits CardGrid {
    in property <[RoomItem]> rooms;
    callback selected(int);
    item-count: rooms.length;
    for room[index] in root.rooms: RoomShortcut {
        width: root.cell-width;
        height: root.row-height;
        x: root.item-x(index);
        y: root.item-y(index);
        visible: root.near(index);
        item: room;
        dark-mode: root.dark-mode;
        chosen => { root.selected(index); }
        activity => { root.activity(); }
    }
}

component EmptyState inherits Rectangle {
    in property <bool> dark-mode;
    in property <bool> german;
    in property <string> title;
    in property <string> description;
    height: body.preferred-height;
    border-radius: 22px;
    background: Palette.surface;
    border-width: 1px;
    border-color: Palette.border;
    body := VerticalLayout {
        padding: 24px;
        spacing: 10px;
        Image {
            source: @image-url("../../../assets/icons/home-outline.svg");
            width: 29px;
            height: 29px;
            colorize: Palette.accent;
        }
        Text {
            text: root.title;
            color: Palette.text;
            font-size: 22px;
            font-weight: 600;
            wrap: word-wrap;
        }
        Text {
            text: root.description;
            color: Palette.muted;
            font-size: 18px;
            wrap: word-wrap;
        }
    }
}

component HomeButton inherits Rectangle {
    in property <bool> german;
    in property <bool> dark-mode;
    callback chosen();
    accessible-role: button;
    accessible-label: german ? "Startseite" : "Home";
    accessible-action-default => { root.chosen(); }
    width: 144px;
    height: 58px;
    border-radius: 16px;
    background: touch.pressed ? Palette.surface-pressed : Palette.soft;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Rectangle {
            width: 30px;
            Image {
                width: 30px;
                height: 30px;
                source: @image-url("../../../assets/icons/home-outline.svg");
                colorize: Palette.accent;
            }
        }
        if root.width > 100px: Text {
            text: root.german ? "Startseite" : "Home";
            font-size: 20px;
            font-weight: 600;
            color: Palette.text;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.chosen(); } }
}

component NavigationButton inherits Rectangle {
    in property <string> label;
    in property <bool> dark-mode;
    callback chosen();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.chosen(); }
    height: 56px;
    min-width: 104px;
    border-radius: 15px;
    background: nav-touch.pressed ? Palette.surface-pressed : Palette.soft;
    Text {
        text: root.label;
        color: Palette.accent;
        font-size: 18px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    nav-touch := TouchArea { clicked => { root.chosen(); } }
}

component LanguageSelector inherits Rectangle {
    in property <bool> german;
    in property <bool> dark-mode: Palette.dark;
    callback toggle-language();
    width: 244px;
    height: 48px;
    border-radius: 15px;
    background: Palette.soft;
    border-width: 1px;
    border-color: Palette.border;

    HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        Rectangle {
            border-radius: 11px;
            background: root.german ? transparent : Palette.surface;
            border-width: root.german ? 0px : 1px;
            border-color: Palette.border;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                Rectangle {
                    width: 27px;
                    background: transparent;
                    Image {
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../../../assets/icons/flag-gb.svg");
                        width: 27px;
                        height: 18px;
                        image-fit: contain;
                    }
                }
                Text { text: "English"; color: Palette.text; font-size: 15px; font-weight: root.german ? 550 : 700; vertical-alignment: center; }
            }
            TouchArea { clicked => { if root.german { root.toggle-language(); } } }
        }
        Rectangle {
            border-radius: 11px;
            background: root.german ? Palette.surface : transparent;
            border-width: root.german ? 1px : 0px;
            border-color: Palette.border;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                Rectangle {
                    width: 27px;
                    background: transparent;
                    Image {
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../../../assets/icons/flag-de.svg");
                        width: 27px;
                        height: 18px;
                        image-fit: contain;
                    }
                }
                Text { text: "Deutsch"; color: Palette.text; font-size: 15px; font-weight: root.german ? 700 : 550; vertical-alignment: center; }
            }
            TouchArea { clicked => { if !root.german { root.toggle-language(); } } }
        }
    }
}

component SetupProgressIndicator inherits Rectangle {
    width: 116px;
    height: 28px;
    background: transparent;
    private property <int> phase: 0;

    Timer {
        interval: 240ms;
        running: !Palette.reduced-motion;
        triggered => { root.phase = Math.mod(root.phase + 1, 3); }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 12px;
        for dot[index] in 3: Rectangle {
            width: index == root.phase ? 18px : 13px;
            height: self.width;
            border-radius: self.width / 2;
            background: index == root.phase ? Palette.accent-line : Palette.dot-off;
            animate width { duration: Palette.reduced-motion ? 0ms : 140ms; }
            animate background { duration: Palette.reduced-motion ? 0ms : 140ms; }
        }
    }
}

export component MainWindow inherits Window {
    default-font-family: "Inter";
    in property <[TileItem]> tiles: [];
    in property <[TileItem]> favorites: [];
    in property <[RoomItem]> rooms: [];
    in property <int> selected-room: -1;
    in property <string> home-view: "mixed";
    in property <bool> rooms-page: false;
    in property <DetailsItem> details-data;
    in-out property <bool> dark-mode <=> Palette.dark;
    in-out property <string> color-scheme <=> Palette.scheme;
    in-out property <bool> increased-contrast <=> Palette.increased-contrast;
    in-out property <bool> reduced-motion <=> Palette.reduced-motion;
    in property <bool> german: false;
    in property <bool> boot-screen: true;
    in property <bool> connection-ready: false;
    in property <string> network-link: "";
    in property <bool> management-degraded: false;
    /// `approve` while the tablet waits for approval in Home Assistant, `conflict` when its ID
    /// is paired with another key; empty otherwise.
    in property <string> pairing-stage: "";
    in property <string> pairing-code: "";
    /// Orientation, theme and colour scheme are set in Home Assistant, not on the tablet.
    in property <bool> settings-managed: false;
    in-out property <bool> inspect-status: false;
    private property <bool> forget-armed: false;
    private property <string> alarm-code: "";
    in property <bool> allow-forget: false;
    in property <bool> orientation-landscape: false;
    in property <bool> orientation-flipped: false;
    // "light", "dark" or "automatic".
    in property <string> theme: "light";
    in property <int> omitted-entities: 0;
    in property <bool> command-warning: false;
    in property <string> connection-text: "";
    in property <bool> details-open: false;
    in property <bool> use-entity-controls: false;
    in property <[ControlItem]> entity-controls;
    in property <[ControlItem]> transport-controls;
    in property <[ControlItem]> seek-controls;
    in property <float> media-position;
    in property <[ResultItem]> entity-results;
    in-out property <bool> showing-results: false;
    in property <string> entity-result-message;
    in property <string> entity-error;
    in property <bool> controls-available;
    in property <bool> media-can-browse;
    in property <bool> media-can-play;
    in property <string> media-title;
    in property <string> media-artist;
    in property <string> media-album;
    in property <string> media-timing;
    in property <image> entity-image;
    in property <string> image-status;
    in-out property <bool> editing-controls: false;
    in property <bool> details-fullscreen: false;
    in property <bool> display-off: false;
    in property <bool> show-clock: false;
    in property <string> clock-time: "00:00";
    in property <float> display-dim-opacity: 0;

    private property <bool> landscape: self.width > self.height && self.width >= 900px;
    private property <bool> has-selected-room: root.selected-room >= 0 && root.selected-room < root.rooms.length;
    private property <bool> show-favorite-grid: !root.has-selected-room && !root.rooms-page && root.home-view != "rooms" && root.favorites.length > 0;
    private property <bool> show-page-heading: !root.has-selected-room && (root.home-view != "mixed" || root.rooms-page);
    private property <bool> show-room-grid: !root.has-selected-room && root.rooms.length > 0 && (root.home-view == "rooms" || root.rooms-page || root.home-view == "mixed");
    private property <bool> show-empty-state: root.has-selected-room
        ? root.tiles.length == 0
        : root.home-view == "favorites"
            ? (root.rooms-page ? root.rooms.length == 0 : root.favorites.length == 0)
            : root.home-view == "mixed"
                ? root.favorites.length == 0 && root.rooms.length == 0
                : root.rooms.length == 0;
    private property <int> tile-columns: self.width > 1080px ? 3 : self.width > 620px ? 2 : 1;
    private property <int> favorite-row-count: (root.favorites.length + root.tile-columns - 1) / root.tile-columns;
    private property <bool> indicator-phase: false;

    callback activate-entity(string);
    callback request-details(string);
    callback room-selected(int);
    callback show-rooms();
    callback go-home();
    callback activity();
    callback wake-display();
    callback dismiss-details();
    // Entity, action key (`level`, `option`, `lock`, `unlock`, `play_pause`, `next`, `previous`,
    // `trigger`, `arm_*`, `disarm`, `refresh_camera`) and its argument (a value, an option or a code).
    callback detail-action(string, string, string);
    callback control-submit(string, string, [InputItem]);
    callback virtual-key(string);
    callback forget-setup();
    callback toggle-language();
    // "portrait", "landscape" or "flip" (turn the screen upside down).
    callback set-orientation(string);
    callback set-theme(string);

    title: "Njörun";
    background: Palette.page;
    min-width: 440px;
    min-height: 600px;

    // The software renderer embeds only ASCII and characters found in string literals.
    // Listing the Latin set here lets user-defined names (areas, entities) render fully.
    Text {
        visible: false;
        width: 0px;
        height: 0px;
        font-size: 12px;
        text: "ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÑÒÓÔÕÖØÙÚÛÜÝßàáâãäåæçèéêëìíîïñòóôõöøùúûüýÿœŒ€„“”‚‘’–—°";
    }

    Timer {
        interval: 900ms;
        running: !root.connection-ready && !root.reduced-motion;
        triggered => { root.indicator-phase = !root.indicator-phase; }
    }

    if boot-screen: Rectangle {
        background: #0c1d27;
        VerticalLayout {
            alignment: center;
            spacing: 20px;
            Image {
                source: @image-url("../../../assets/brand/boot.svg");
                image-fit: contain;
                width: min(parent.width * 0.82, parent.height * 0.74);
                height: min(parent.width * 0.82, parent.height * 0.74);
            }
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.indicator-phase ? #75e0c2 : #2d7f76;
                }
                Text {
                    text: root.connection-text == ""
                        ? (root.german ? "Njörun startet" : "Starting Njörun")
                        : root.connection-text;
                    color: #a8c4c7;
                    font-size: 15px;
                    vertical-alignment: center;
                }
            }
        }
    }
    if !boot-screen && root.pairing-stage == "": VerticalLayout {
        spacing: 0px;
        padding: landscape ? 24px : 20px;
        padding-top: 0px;

        if root.height >= 360px: HorizontalLayout {
            height: root.height < 440px ? 56px : 76px;
            spacing: 12px;
            if root.width >= 420px: Text {
                text: root.german ? "Zuhause" : "Home";
                font-size: 24px;
                font-weight: 600;
                color: Palette.text;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.network-link != "" && root.width >= 600px: Rectangle {
                width: 28px;
                accessible-role: image;
                accessible-label: root.network-link == "ethernet" ? "Ethernet" : "Wi-Fi";
                Image {
                    y: (parent.height - self.height) / 2;
                    width: 24px; height: 24px;
                    source: root.network-link == "ethernet" ? @image-url("../../../assets/icons/ethernet.svg")
                        : root.network-link == "wifi1" ? @image-url("../../../assets/icons/wifi-strength-1.svg")
                        : root.network-link == "wifi2" ? @image-url("../../../assets/icons/wifi-strength-2.svg")
                        : root.network-link == "wifi3" ? @image-url("../../../assets/icons/wifi-strength-3.svg")
                        : root.network-link == "wifi4" ? @image-url("../../../assets/icons/wifi-strength-4.svg")
                        : @image-url("../../../assets/icons/wifi.svg");
                    colorize: Palette.icon;
                }
            }
            Rectangle {
                width: 56px;
                accessible-role: button;
                accessible-label: root.connection-text;
                Image {
                    y: (parent.height - self.height) / 2;
                    x: (parent.width - self.width) / 2;
                    width: 26px; height: 26px;
                    source: root.management-degraded ? @image-url("../../../assets/icons/server-minus.svg")
                        : root.connection-ready ? @image-url("../../../assets/icons/server-network.svg")
                        : @image-url("../../../assets/icons/server-network-off.svg");
                    colorize: !root.connection-ready || root.management-degraded
                        ? Palette.warning : Palette.icon;
                    opacity: !root.reduced-motion && !root.connection-ready && root.indicator-phase ? 0.55 : 1;
                }
                TouchArea { clicked => { root.inspect-status = !root.inspect-status; root.forget-armed = false; } }
            }
            Rectangle {
                width: clock-label.preferred-width;
                clock-label := Text {
                    text: root.clock-time;
                    font-size: 24px;
                    font-weight: 650;
                    height: self.preferred-height;
                    // Align the visible digits with the icon ink, allowing for font descent.
                    y: (parent.height - self.height) / 2 + 1px;
                    color: Palette.text;
                }
            }
        }

        if root.omitted-entities > 0: Text {
            text: root.german ? root.omitted-entities + " Entitäten nicht angezeigt. Auswahl in Home Assistant eingrenzen."
                : root.omitted-entities + " entities not shown. Refine the selection in Home Assistant.";
            color: Palette.warning; font-size: 18px; wrap: word-wrap;
        }
        if !root.connection-ready || root.management-degraded: Text {
            text: root.connection-text;
            color: Palette.warning;
            font-size: 18px;
            wrap: word-wrap;
        }

        if landscape: HorizontalLayout {
            spacing: 18px;
            if root.has-selected-room: VerticalLayout {
                width: 224px;
                spacing: 9px;
                padding-top: 12px;
                HomeButton {
                    width: parent.width;
                    german: root.german;
                    dark-mode: root.dark-mode;
                    chosen => { root.go-home(); }
                }
                Text {
                    text: root.german ? "Räume" : "Rooms";
                    color: Palette.subtle;
                    font-size: 20px;
                    font-weight: 700;
                    letter-spacing: 0px;
                    height: 24px;
                    vertical-alignment: center;
                }
                if root.rooms.length == 0: Text {
                    text: root.german ? "Noch keine Räume" : "No rooms yet";
                    color: Palette.muted;
                    font-size: 18px;
                    wrap: word-wrap;
                }
                Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: root.rooms.length * 68px;
                    for room[index] in root.rooms: RoomShortcut {
                        x: 0px;
                        y: index * 68px;
                        width: parent.width;
                        item: room;
                        dark-mode: root.dark-mode;
                        selected: root.selected-room == index;
                        compact: true;
                        chosen => { root.room-selected(index); }
                        activity => { root.activity(); }
                    }
                }
            }
            if root.has-selected-room: Rectangle {
                width: 1px;
                background: Palette.border;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                max-width: root.width;
                spacing: 14px;
                if root.has-selected-room: HorizontalLayout {
                    height: 58px;
                    Text {
                        text: root.rooms[root.selected-room].name;
                        color: Palette.text;
                        font-size: 32px;
                        font-weight: 650;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.rooms-page: NavigationButton {
                        label: root.german ? "‹ Räume" : "‹ Rooms";
                        dark-mode: root.dark-mode;
                        chosen => { root.room-selected(-1); }
                    }
                }
                if root.show-page-heading: HorizontalLayout {
                    height: 58px;
                    if root.rooms-page: HomeButton {
                        german: root.german;
                        dark-mode: root.dark-mode;
                        chosen => { root.go-home(); }
                    }
                    Text {
                        text: root.home-view == "favorites" && !root.rooms-page
                            ? (root.german ? "Favoriten" : "Favorites")
                            : (root.german ? "Räume" : "Rooms");
                        color: Palette.text;
                        font-size: 32px;
                        font-weight: 650;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.home-view == "favorites" && !root.rooms-page: NavigationButton {
                        label: root.german ? "Räume" : "Rooms";
                        dark-mode: root.dark-mode;
                        chosen => { root.show-rooms(); }
                    }

                }
                if root.home-view == "mixed" && root.show-favorite-grid: Text {
                    text: root.german ? "Favoriten" : "Favorites";
                    height: 28px;
                    color: Palette.subtle;
                    font-size: 20px;
                    font-weight: 700;
                    letter-spacing: 0px;
                }
                if root.show-empty-state: EmptyState {
                    dark-mode: root.dark-mode;
                    german: root.german;
                    title: root.has-selected-room
                        ? (root.german ? "Keine Steuerelemente in diesem Raum" : "No controls in this room")
                        : root.home-view == "favorites" && !root.rooms-page
                            ? (root.german ? "Noch keine Favoriten" : "No favorites yet")
                            : (root.german ? "Noch keine Räume oder Steuerelemente" : "No rooms or controls yet");
                    description: root.home-view == "favorites" && !root.rooms-page
                        ? (root.german ? "Wähle Favoriten in den Njörun-Einstellungen in Home Assistant aus." : "Choose favorites in the Njörun settings in Home Assistant.")
                        : (root.german ? "Füge in Home Assistant unterstützte Lichter, Schalter, Szenen oder Sensoren zu einem Bereich hinzu." : "Add supported lights, switches, scenes or sensors to an area in Home Assistant.");
                }
                if root.has-selected-room: EntityGrid {
                    context: root.selected-room;
                    items: root.tiles;
                    gap: 14px;
                    dark-mode: root.dark-mode;
                    german: root.german;
                    activate(id) => { root.activate-entity(id); }
                    request-details(id) => { root.request-details(id); }
                    activity => { root.activity(); }
                }
                if root.show-favorite-grid: EntityGrid {
                    items: root.favorites;
                    gap: 14px;
                    dark-mode: root.dark-mode;
                    german: root.german;
                    max-height: root.home-view == "mixed" ? min(root.height * 0.42, root.favorite-row-count * 142px) : root.height;
                    activate(id) => { root.activate-entity(id); }
                    request-details(id) => { root.request-details(id); }
                    activity => { root.activity(); }
                }
                if root.home-view == "mixed" && root.show-room-grid: Text {
                    height: 28px;
                    text: root.german ? "Räume" : "Rooms";
                    color: Palette.subtle;
                    font-size: 20px;
                    font-weight: 700;
                    letter-spacing: 0px;
                }
                if root.show-room-grid: RoomGrid {
                    rooms: root.rooms;
                    german: root.german;
                    gap: 14px;
                    dark-mode: root.dark-mode;
                    selected(index) => { root.room-selected(index); }
                    activity => { root.activity(); }
                }
            }
        }
        if !landscape: VerticalLayout {
            spacing: 12px;
            if root.rooms.length > 0 && root.has-selected-room && root.height >= 440px: HorizontalLayout {
                height: 58px;
                spacing: 9px;
                HomeButton {
                    width: root.width < 500px ? 56px : 144px;
                    german: root.german;
                    dark-mode: root.dark-mode;
                    chosen => { root.go-home(); }
                }
                Flickable {
                    horizontal-stretch: 1;
                    content-width: max(self.width, root.rooms.length * 200px + max(0, root.rooms.length - 1) * 9px);
                    content-height: self.height;
                    room-tabs := HorizontalLayout {
                        width: root.rooms.length * 200px + max(0, root.rooms.length - 1) * 9px;
                        spacing: 9px;
                        for room[index] in root.rooms: RoomShortcut {
                            width: 200px;
                            item: room;
                            dark-mode: root.dark-mode;
                            selected: root.selected-room == index;
                            compact: true;
                            chosen => { root.room-selected(index); }
                            activity => { root.activity(); }
                        }
                    }
                }
            }
            if root.has-selected-room: HorizontalLayout {
                height: root.height < 440px ? 56px : 48px;
                if root.height < 440px: HomeButton {
                    width: 56px;
                    german: root.german;
                    chosen => { root.go-home(); }
                }
                Text {
                    text: root.rooms[root.selected-room].name;
                    color: Palette.text;
                    font-size: 30px;
                    font-weight: 650;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.rooms-page: NavigationButton {
                    label: root.german ? "‹ Räume" : "‹ Rooms";
                    dark-mode: root.dark-mode;
                    chosen => { root.room-selected(-1); }
                }
            }
            if root.show-page-heading: HorizontalLayout {
                height: root.rooms-page ? 58px : 48px;
                if root.rooms-page: HomeButton {
                    german: root.german;
                    dark-mode: root.dark-mode;
                    chosen => { root.go-home(); }
                }
                Text {
                    text: root.home-view == "favorites" && !root.rooms-page
                        ? (root.german ? "Favoriten" : "Favorites")
                        : (root.german ? "Räume" : "Rooms");
                    color: Palette.text;
                    font-size: 30px;
                    font-weight: 650;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.home-view == "favorites" && !root.rooms-page: NavigationButton {
                    label: root.german ? "Räume" : "Rooms";
                    dark-mode: root.dark-mode;
                    chosen => { root.show-rooms(); }
                }

            }
            if root.home-view == "mixed" && root.show-favorite-grid: Text {
                text: root.german ? "Favoriten" : "Favorites";
                height: 28px;
                color: Palette.subtle;
                font-size: 20px;
                font-weight: 700;
                letter-spacing: 0px;
            }
            if root.show-empty-state: EmptyState {
                dark-mode: root.dark-mode;
                german: root.german;
                title: root.has-selected-room
                    ? (root.german ? "Keine Steuerelemente in diesem Raum" : "No controls in this room")
                    : root.home-view == "favorites" && !root.rooms-page
                        ? (root.german ? "Noch keine Favoriten" : "No favorites yet")
                        : (root.german ? "Noch keine Räume oder Steuerelemente" : "No rooms or controls yet");
                description: root.home-view == "favorites" && !root.rooms-page
                    ? (root.german ? "Wähle Favoriten in den Njörun-Einstellungen in Home Assistant aus." : "Choose favorites in the Njörun settings in Home Assistant.")
                    : (root.german ? "Füge in Home Assistant unterstützte Lichter, Schalter, Szenen oder Sensoren zu einem Bereich hinzu." : "Add supported lights, switches, scenes or sensors to an area in Home Assistant.");
            }
            if root.has-selected-room: EntityGrid {
                context: root.selected-room;
                items: root.tiles;
                gap: 14px;
                dark-mode: root.dark-mode;
                german: root.german;
                activate(id) => { root.activate-entity(id); }
                request-details(id) => { root.request-details(id); }
                activity => { root.activity(); }
            }
            if root.show-favorite-grid: EntityGrid {
                items: root.favorites;
                gap: 14px;
                dark-mode: root.dark-mode;
                german: root.german;
                max-height: root.home-view == "mixed" ? min(root.height * 0.42, root.favorite-row-count * 140px) : root.height;
                activate(id) => { root.activate-entity(id); }
                request-details(id) => { root.request-details(id); }
                activity => { root.activity(); }
            }
            if root.home-view == "mixed" && root.show-room-grid: Text {
                height: 28px;
                text: root.german ? "Räume" : "Rooms";
                color: Palette.subtle;
                font-size: 20px;
                font-weight: 700;
                letter-spacing: 0px;
            }
            if root.show-room-grid: RoomGrid {
                rooms: root.rooms;
                german: root.german;
                gap: 14px;
                dark-mode: root.dark-mode;
                selected(index) => { root.room-selected(index); }
                activity => { root.activity(); }
            }
        }
    }

    if details-open: Rectangle {
        background: #00000066;
        TouchArea {
            clicked => { root.dismiss-details(); }
        }
        Rectangle {
            x: root.details-fullscreen ? 0px : root.landscape ? max(0px, root.width - 560px) : 0px;
            y: root.details-fullscreen ? 0px : root.landscape ? 0px : root.height - self.height;
            width: root.details-fullscreen ? root.width : root.landscape ? min(560px, root.width) : root.width;
            // The sheet grows with its content up to most of the screen, which a large interface
            // size needs; it is never lower than before.
            height: root.details-fullscreen ? root.height : root.landscape ? root.height : min(root.height - 24px, max(360px, sheet-content.preferred-height));
            border-radius: root.details-fullscreen ? 0px : root.landscape ? 0px : 26px;
            background: Palette.surface;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea { clicked => { } }

            sheet-content := VerticalLayout {
                padding: root.landscape ? 28px : 24px;
                spacing: 17px;
                HorizontalLayout {
                    spacing: 14px;
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: 18px;
                        background: Palette.active-surface;
                        Image {
                            source: Icons.source(root.details-data.icon);
                            width: 36px;
                            height: 36px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: Palette.accent;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 5px;
                        Text {
                            text: root.german ? "Details" : "Details";
                            color: Palette.text;
                            font-size: 20px;
                            font-weight: 650;
                            overflow: elide;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 60px;
                        height: 60px;
                        accessible-role: button;
                        accessible-label: root.german ? "Schließen" : "Close";
                        accessible-action-default => { root.dismiss-details(); }
                        border-radius: 18px;
                        background: Palette.soft;
                        Text {
                            text: "×";
                            color: Palette.icon;
                            font-size: 32px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.dismiss-details(); } }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    preferred-height: detail-body.preferred-height;
                    clip: true;
                    // Where more content follows, the bottom edge fades out as the cue to swipe up.
                    Rectangle {
                        y: parent.height - self.height;
                        height: 44px;
                        z: 1;
                        visible: detail-flick.content-y + detail-flick.content-height > detail-flick.height + 1px;
                        background: @linear-gradient(
                            180deg,
                            Palette.surface.transparentize(1) 0%,
                            Palette.surface 100%
                        );
                    }
                detail-flick := Flickable {
                    in property <bool> showing-response: root.showing-results;
                    changed showing-response => { self.content-y = 0px; }
                    width: parent.width;
                    height: parent.height;
                    content-width: self.width;
                    content-height: detail-body.preferred-height;
                    detail-body := VerticalLayout {
                        width: parent.width;
                        spacing: 16px;
                        Text {
                            text: root.details-data.name;
                            color: Palette.text;
                            font-size: 28px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                        if root.use-entity-controls && root.entity-image.width > 0: Image {
                            source: root.entity-image;
                            height: min(self.width * root.entity-image.height / root.entity-image.width, root.details-data.control == "camera" ? 520px : 260px);
                            image-fit: contain;
                        }
                        if root.use-entity-controls && root.image-status != "": Text {
                            text: root.image-status; color: Palette.muted; font-size: 20px; wrap: word-wrap;
                        }
                        if root.media-title != "" && root.use-entity-controls: VerticalLayout {
                            spacing: 8px;
                            Text { text: root.media-title; color: Palette.text; font-size: 32px; font-weight: 600; wrap: word-wrap; }
                            if root.media-artist != "": Text { text: root.media-artist; color: Palette.muted; font-size: 24px; wrap: word-wrap; }
                            if root.media-album != "": Text { text: root.media-album; color: Palette.subtle; font-size: 18px; wrap: word-wrap; }
                            if root.media-timing != "" && root.seek-controls.length == 0: Text { text: root.media-timing; color: Palette.muted; font-size: 20px; }
                        }
                        if root.details-data.can-toggle && !root.use-entity-controls: ActionButton {
                            label: root.german ? "Ein / Aus" : "Power";
                            icon: @image-url("../../../assets/icons/power.svg");
                            enabled: root.details-data.controls-enabled;
                            clicked => { root.activate-entity(root.details-data.entity-id); }
                        }
                        if root.use-entity-controls: VerticalLayout {
                            for control in root.seek-controls: EntityControlCard {
                                item: control; german: root.german; allow-actions: root.controls-available;
                                media-position: root.media-position;
                                action(key, value) => { root.detail-action(root.details-data.entity-id, "entity:" + key, value); }
                            }
                        }
                        if root.media-title == "" || !root.use-entity-controls: Text {
                            text: root.details-data.value;
                            color: root.details-data.unavailable || root.details-data.control == "slider"
                                ? Palette.subtle : Palette.accent;
                            font-size: root.details-data.control == "slider" ? 18px : 40px;
                            font-weight: 650;
                            wrap: word-wrap;
                        }
                        if root.entity-error != "": Text {
                            text: root.entity-error; color: Palette.error; font-size: 20px; wrap: word-wrap;
                        }
                        if root.use-entity-controls && root.transport-controls.length > 0: HorizontalLayout {
                            spacing: 10px;
                            for control in root.transport-controls: ActionButton {
                                icon: Icons.control(control.icon-key);
                                accessible-name: control.label;
                                enabled: control.enabled && root.controls-available;
                                primary: control.icon-key == "play" || control.icon-key == "pause";
                                clicked => { root.detail-action(root.details-data.entity-id, "entity:" + control.key, control.value); }
                            }
                        }
                        if root.use-entity-controls && !root.showing-results: VerticalLayout {
                            spacing: 20px;
                            for control in root.entity-controls: EntityControlCard {
                                item: control; german: root.german; allow-actions: root.controls-available;
                                action(key, value) => { root.detail-action(root.details-data.entity-id, "entity:" + key, value); }
                                submit(key, fields) => { root.control-submit(root.details-data.entity-id, key, fields); }
                                virtual-key(key) => { root.virtual-key(key); }
                                editing-changed(editing) => { root.editing-controls = editing; }
                            }
                        }
                        if root.showing-results: HorizontalLayout {
                            spacing: 12px;
                            ActionButton {
                                label: root.german ? "Zurück zur Steuerung" : "Back to controls";
                                clicked => { root.showing-results = false; }
                            }
                            if root.media-can-browse: ActionButton {
                                label: root.german ? "Mediathek" : "Library";
                                enabled: root.controls-available;
                                clicked => { root.detail-action(root.details-data.entity-id, "entity:media_browse", "{}"); }
                            }
                        }
                        if root.showing-results && root.entity-result-message != "": Text { text: root.entity-result-message; color: Palette.muted; font-size: 20px; wrap: word-wrap; }
                        if root.showing-results: VerticalLayout {
                        spacing: 10px;
                        for result in root.entity-results: Rectangle {
                            min-height: 76px; border-radius: 16px; background: Palette.surface-alt;
                            TouchArea {
                                enabled: result.action != "" && root.controls-available;
                                clicked => { root.detail-action(root.details-data.entity-id, "entity:" + result.action, result.argument); }
                            }
                            HorizontalLayout {
                                padding: 14px; spacing: 14px;
                                VerticalLayout {
                                    spacing: 5px;
                                    if result.title != "": Text { text: result.title; color: Palette.text; font-size: 22px; wrap: word-wrap; }
                                    if result.subtitle != "": Text { text: result.subtitle; color: Palette.muted; font-size: result.title == "" ? 22px : 18px; wrap: word-wrap; }
                                }
                                if result.secondary-action != "": ActionButton {
                                    width: 56px; icon: Icons.control("play"); accessible-name: root.german ? "Wiedergeben" : "Play";
                                    enabled: root.controls-available;
                                    clicked => { root.detail-action(root.details-data.entity-id, "entity:" + result.secondary-action, result.secondary-argument); }
                                }
                            }
                        }
                        }
                        if !root.use-entity-controls && !root.details-data.unavailable && root.details-data.control == "slider": LevelSlider {
                            enabled: root.details-data.controls-enabled;
                            label: root.details-data.icon == EntityIcon.Lightbulb
                                ? (root.german ? "Helligkeit" : "Brightness") : root.details-data.name;
                            minimum: root.details-data.slider-min;
                            maximum: root.details-data.slider-max;
                            step: root.details-data.slider-step;
                            value: root.details-data.slider-value;
                            unit: root.details-data.slider-unit;
                            dark-mode: root.dark-mode;
                            prominent: true;
                            committed(value) => { root.detail-action(root.details-data.entity-id, "level", value); }
                        }
                        if !root.use-entity-controls && !root.details-data.unavailable && root.details-data.control == "options": VerticalLayout {
                            spacing: 8px;
                            for option in root.details-data.options: OptionRow {
                                enabled: root.details-data.controls-enabled;
                                label: option;
                                selected: option == root.details-data.selected-option;
                                dark-mode: root.dark-mode;
                                chosen => { root.detail-action(root.details-data.entity-id, "option", option); }
                            }
                        }
                        if !root.use-entity-controls && !root.details-data.unavailable && root.details-data.control == "lock": ActionButton {
                            enabled: root.details-data.controls-enabled;
                            label: root.details-data.locked ? (root.german ? "Entriegeln" : "Unlock") : (root.german ? "Verriegeln" : "Lock");
                            icon: root.details-data.locked ? @image-url("../../../assets/icons/lock-open-variant.svg") : @image-url("../../../assets/icons/lock.svg");
                            primary: !root.details-data.locked;
                            danger: root.details-data.locked;
                            dark-mode: root.dark-mode;
                            clicked => { root.detail-action(root.details-data.entity-id, root.details-data.locked ? "unlock" : "lock", ""); }
                        }
                        if !root.use-entity-controls && !root.details-data.unavailable && root.details-data.control == "automation": ActionButton {
                            enabled: root.details-data.controls-enabled;
                            label: root.german ? "Jetzt ausführen" : "Run now";
                            icon: @image-url("../../../assets/icons/play.svg");
                            dark-mode: root.dark-mode;
                            clicked => { root.detail-action(root.details-data.entity-id, "trigger", ""); }
                        }
                        if !root.use-entity-controls && !root.details-data.unavailable && root.details-data.control == "media": VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 10px;
                                ActionButton {
                                    icon: @image-url("../../../assets/icons/skip-previous.svg");
                                    enabled: root.details-data.controls-enabled;
                                    accessible-name: root.german ? "Vorheriger Titel" : "Previous track";
                                    dark-mode: root.dark-mode;
                                    clicked => { root.detail-action(root.details-data.entity-id, "previous", ""); }
                                }
                                ActionButton {
                                    icon: root.details-data.playing ? @image-url("../../../assets/icons/pause.svg") : @image-url("../../../assets/icons/play.svg");
                                    enabled: root.details-data.controls-enabled;
                                    accessible-name: root.details-data.playing ? "Pause"
                                        : (root.german ? "Wiedergabe" : "Play");
                                    primary: true;
                                    dark-mode: root.dark-mode;
                                    clicked => { root.detail-action(root.details-data.entity-id, "play_pause", ""); }
                                }
                                ActionButton {
                                    icon: @image-url("../../../assets/icons/skip-next.svg");
                                    enabled: root.details-data.controls-enabled;
                                    accessible-name: root.german ? "Nächster Titel" : "Next track";
                                    dark-mode: root.dark-mode;
                                    clicked => { root.detail-action(root.details-data.entity-id, "next", ""); }
                                }
                            }
                            if root.details-data.has-volume: LevelSlider {
                                enabled: root.details-data.controls-enabled;
                                label: root.german ? "Lautstärke" : "Volume";
                                minimum: root.details-data.slider-min;
                                maximum: root.details-data.slider-max;
                                step: root.details-data.slider-step;
                                value: root.details-data.slider-value;
                                unit: root.details-data.slider-unit;
                                dark-mode: root.dark-mode;
                                committed(value) => { root.detail-action(root.details-data.entity-id, "level", value); }
                            }
                        }
                        if !root.use-entity-controls && !root.details-data.unavailable && root.details-data.control == "alarm": VerticalLayout {
                            spacing: 12px;
                            if root.details-data.needs-code: CodeKeypad {
                                dark-mode: root.dark-mode;
                                code <=> root.alarm-code;
                            }
                            for action in root.details-data.actions: ActionButton {
                                enabled: root.details-data.controls-enabled;
                                label: action.label;
                                primary: action.key != "disarm";
                                danger: action.key == "disarm";
                                dark-mode: root.dark-mode;
                                clicked => {
                                    root.detail-action(root.details-data.entity-id, action.key, root.details-data.needs-code ? root.alarm-code : "");
                                    root.alarm-code = "";
                                }
                            }
                        }
                        if !root.use-entity-controls && !root.details-data.unavailable && root.details-data.control == "camera": VerticalLayout {
                            spacing: 12px;
                            Rectangle {
                                height: root.details-data.camera-image.height > 0
                                    ? min(parent.width * root.details-data.camera-image.height / root.details-data.camera-image.width, 520px) : 180px;
                                border-radius: 16px;
                                clip: true;
                                background: Palette.surface-alt;
                                if root.details-data.camera-image.width > 0: Image {
                                    source: root.details-data.camera-image;
                                    width: parent.width;
                                    height: parent.height;
                                    image-fit: contain;
                                }
                                if root.details-data.camera-image.width == 0: Text {
                                    text: root.details-data.camera-loading ? (root.german ? "Bild wird geladen …" : "Loading picture…") : (root.german ? "Kein Bild" : "No picture");
                                    color: Palette.muted;
                                    font-size: 18px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    enabled: root.details-data.controls-enabled;
                                    clicked => { root.detail-action(root.details-data.entity-id, "refresh_camera", ""); }
                                }
                            }
                            ActionButton {
                                label: root.german ? "Aktualisieren" : "Refresh";
                                enabled: root.details-data.controls-enabled;
                                icon: @image-url("../../../assets/icons/reload.svg");
                                dark-mode: root.dark-mode;
                                clicked => { root.detail-action(root.details-data.entity-id, "refresh_camera", ""); }
                            }
                        }
                        if root.details-data.reason != "": Text {
                            text: root.details-data.reason;
                            color: Palette.error;
                            font-size: 18px;
                            wrap: word-wrap;
                        }
                        if root.details-data.update-time != "": Text {
                            text: (root.german ? "Aktualisiert: " : "Updated: ") + root.details-data.update-time;
                            color: Palette.muted;
                            font-size: 16px;
                            wrap: word-wrap;
                        }
                        if root.details-data.attributes != "": DetailField {
                            label: "Details";
                            value: root.details-data.attributes;
                            dark-mode: root.dark-mode;
                        }
                    }
                }
                }
            }
        }
    }

    // A tap anywhere outside the panel closes it.
    if !boot-screen && inspect-status: TouchArea {
        clicked => {
            root.inspect-status = false;
            root.forget-armed = false;
        }
    }
    if !boot-screen && (inspect-status || command-warning): Rectangle {
        x: parent.width - self.width - 14px;
        y: root.height < 360px ? 14px : root.height < 440px ? 62px : 82px;
        width: min(parent.width - 28px, message.preferred-width + 24px);
        height: 48px;
        background: Palette.soft;
        border-radius: 8px;
        message := Text {
            text: root.connection-text;
            color: Palette.text;
            font-size: 16px;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
    if !boot-screen && inspect-status && allow-forget: Rectangle {
        x: parent.width - self.width - 14px;
        y: (root.height < 360px ? 14px : root.height < 440px ? 62px : 82px) + 56px;
        width: min(parent.width - 28px, 440px);
        height: min(card-content.preferred-height, parent.height - self.y - 14px);
        border-radius: 18px;
        background: Palette.surface;
        border-width: 1px;
        border-color: Palette.border;
        TouchArea { clicked => { } }
        Flickable {
            width: parent.width;
            height: parent.height;
            content-width: self.width;
            content-height: card-content.preferred-height;
            card-content := VerticalLayout {
                width: parent.width;
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    height: 56px;
                    Text {
                        text: root.german ? "Einstellungen" : "Settings";
                        color: Palette.text;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 56px;
                        border-radius: 22px;
                        background: close-touch.pressed ? Palette.surface-pressed : transparent;
                        accessible-role: button;
                        accessible-label: root.german ? "Schließen" : "Close";
                        accessible-action-default => {
                            root.inspect-status = false;
                            root.forget-armed = false;
                        }
                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 26px;
                            height: 26px;
                            source: @image-url("../../../assets/icons/close.svg");
                            colorize: Palette.icon;
                        }
                        close-touch := TouchArea {
                            clicked => {
                                root.inspect-status = false;
                                root.forget-armed = false;
                            }
                        }
                    }
                }
                if !root.settings-managed: VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: root.german ? "Sprache" : "Language";
                        color: Palette.muted;
                        font-size: 14px;
                        font-weight: 650;
                    }
                    HorizontalLayout {
                        alignment: start;
                        LanguageSelector {
                            german: root.german;
                            dark-mode: root.dark-mode;
                            toggle-language => { root.toggle-language(); }
                        }
                    }
                }
                if !root.settings-managed: VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: root.german ? "Ausrichtung" : "Orientation";
                        color: Palette.muted;
                        font-size: 14px;
                        font-weight: 650;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        ChoiceButton {
                            label: root.german ? "Hochformat" : "Portrait";
                            selected: !root.orientation-landscape;
                            dark-mode: root.dark-mode;
                            clicked => { root.set-orientation("portrait"); }
                        }
                        ChoiceButton {
                            label: root.german ? "Querformat" : "Landscape";
                            selected: root.orientation-landscape;
                            dark-mode: root.dark-mode;
                            clicked => { root.set-orientation("landscape"); }
                        }
                        ChoiceButton {
                            label: root.german ? "Drehen 180°" : "Flip 180°";
                            selected: root.orientation-flipped;
                            dark-mode: root.dark-mode;
                            clicked => { root.set-orientation("flip"); }
                        }
                    }
                    Text {
                        text: root.german ? "Darstellung" : "Theme";
                        color: Palette.muted;
                        font-size: 14px;
                        font-weight: 650;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        ChoiceButton {
                            label: root.german ? "Hell" : "Light";
                            selected: root.theme == "light";
                            dark-mode: root.dark-mode;
                            clicked => { root.set-theme("light"); }
                        }
                        ChoiceButton {
                            label: root.german ? "Dunkel" : "Dark";
                            selected: root.theme == "dark";
                            dark-mode: root.dark-mode;
                            clicked => { root.set-theme("dark"); }
                        }
                        ChoiceButton {
                            label: root.german ? "Automatisch" : "Automatic";
                            selected: root.theme == "automatic";
                            dark-mode: root.dark-mode;
                            clicked => { root.set-theme("automatic"); }
                        }
                    }
                }
                if root.settings-managed: Text {
                    text: root.german ? "Sprache, Ausrichtung, Darstellung und Farbschema stellst du in Home Assistant ein." : "Language, orientation, theme and colour scheme are set in Home Assistant.";
                    color: Palette.muted;
                    font-size: 16px;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 56px;
                    border-radius: 14px;
                    background: root.forget-armed ? (forget-touch.pressed ? Palette.danger-surface-pressed : Palette.danger-surface)
                        : forget-touch.pressed ? Palette.surface-pressed : Palette.soft;
                    border-width: root.forget-armed ? 1px : 0px;
                    border-color: Palette.error-line;
                    accessible-role: button;
                    accessible-label: root.forget-armed
                        ? (root.german ? "Zurücksetzen bestätigen" : "Confirm reset")
                        : (root.german ? "Einrichtung zurücksetzen" : "Reset setup");
                    accessible-action-default => {
                        if root.forget-armed { root.forget-setup(); }
                        else { root.forget-armed = true; }
                    }
                    Text {
                        text: root.forget-armed
                            ? (root.german ? "Zum Bestätigen erneut tippen" : "Tap again to confirm")
                            : (root.german ? "Einrichtung zurücksetzen" : "Reset setup");
                        color: root.forget-armed ? Palette.on-danger : Palette.text;
                        font-size: 18px;
                        font-weight: 650;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    forget-touch := TouchArea {
                        clicked => {
                            if root.forget-armed {
                                root.forget-setup();
                            } else {
                                root.forget-armed = true;
                            }
                        }
                    }
                }
            }
        }
    }
    if !boot-screen && show-clock: Rectangle {
        background: #07131b;
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            Text {
                text: root.clock-time;
                color: #edf8f5;
                font-size: root.landscape ? 92px : 82px;
                font-weight: 300;
                horizontal-alignment: center;
            }
            Text {
                text: root.german ? "Ortszeit" : "Local time";
                color: #83a0a6;
                font-size: 15px;
                letter-spacing: 2px;
                horizontal-alignment: center;
            }
        }
    }
    if !boot-screen && display-off: Rectangle {
        background: #000000;
    }
    if !boot-screen && display-dim-opacity > 0: Rectangle {
        background: #000000;
        opacity: root.display-dim-opacity;
    }
    if !boot-screen && (display-off || show-clock): Rectangle {
        background: #00000000;
        TouchArea {
            clicked => { root.wake-display(); }
        }
    }
    // Same look as the first-run screens: shown whenever the tablet is not approved in HA.
    if !boot-screen && root.pairing-stage != "": Rectangle {
        background: Palette.page;
        TouchArea { }
        VerticalLayout {
            padding-left: root.landscape ? 34px : 22px;
            padding-right: root.landscape ? 34px : 22px;
            padding-top: root.landscape ? 18px : 14px;
            padding-bottom: root.landscape ? 22px : 18px;
            spacing: 14px;
            // On a low screen, for example at a large interface size, the header makes room.
            if root.height >= 520px: HorizontalLayout {
                height: root.landscape ? 72px : 64px;
                spacing: 14px;
                // Narrow, for example at a large interface size, only the language choice stays.
                if root.width >= 560px: Rectangle {
                    width: root.landscape ? 174px : 152px;
                    Image {
                        source: root.dark-mode ? @image-url("../../../assets/brand/wordmark-dark.svg") : @image-url("../../../assets/brand/wordmark-light.svg");
                        width: parent.width;
                        height: self.width / 2.7143;
                        y: (parent.height - self.height) / 2;
                        image-fit: contain;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                LanguageSelector {
                    y: (parent.height - self.height) / 2;
                    german: root.german;
                    toggle-language => { root.toggle-language(); }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.width >= 560px: Rectangle {
                    width: root.landscape ? 174px : 152px;
                    Text {
                        text: root.clock-time;
                        color: Palette.text;
                        font-size: 22px;
                        font-weight: 650;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }
            VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: min(root.landscape ? 30px : 38px, root.height * 0.035);
                Text {
                    text: root.pairing-stage == "approve"
                        ? (root.german ? "Tablet freigeben" : "Approve this tablet")
                        : (root.german ? "Diese Tablet-ID ist bereits vergeben" : "This tablet ID is already in use");
                    color: Palette.text;
                    font-size: min(root.landscape ? 40px : 44px, root.width / 7, root.height / 9);
                    font-weight: 700;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    Text {
                        max-width: root.landscape ? 880px : 680px;
                        text: root.pairing-stage == "approve"
                            ? (root.german
                                ? "Öffne Home Assistant → Einstellungen → Geräte & Dienste. Unter „Entdeckt“ erscheint dieses Tablet. Bestätige dort, wenn der Code stimmt."
                                : "Open Home Assistant → Settings → Devices & services. This tablet appears under “Discovered”. Confirm there if the code matches.")
                            : (root.german
                                ? "Unter derselben ID ist ein anderes Tablet gekoppelt. Lösche in Home Assistant unter Njörun das Gerät des alten Tablets."
                                : "Another tablet is paired under the same ID. In Home Assistant, delete the old tablet’s device under Njörun.");
                        color: Palette.muted;
                        font-size: min(22px, root.width / 15, root.height / 16);
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
                if root.pairing-stage == "approve": HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        // The code box and its digits shrink with the room there is.
                        width: min(root.landscape ? 600px : 660px, root.width - 44px);
                        height: min(root.landscape ? 190px : 230px, self.width * 0.4, root.height * 0.26);
                        border-radius: 28px;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: Palette.border;
                        Text {
                            width: parent.width;
                            text: root.pairing-code;
                            color: Palette.text;
                            font-size: min(root.landscape ? 112px : 124px, parent.width / 5.2, parent.height * 0.62);
                            font-weight: 700;
                            letter-spacing: 6px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.width >= 440px: HorizontalLayout {
                    alignment: center;
                    spacing: 16px;
                    SetupProgressIndicator { }
                    Text {
                        text: root.german ? "Warte auf Freigabe …" : "Waiting for approval …";
                        color: Palette.muted;
                        font-size: 20px;
                        vertical-alignment: center;
                    }
                }
                if root.width < 440px: VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    SetupProgressIndicator { }
                    Text {
                        text: root.german ? "Warte auf Freigabe …" : "Waiting for approval …";
                        color: Palette.muted;
                        font-size: min(20px, root.width / 17);
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

component SetupButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> has-icon: false;
    in property <image> icon;
    callback chosen();
    min-height: 54px;
    min-width: 130px;
    horizontal-stretch: 0;
    border-radius: 16px;
    background: !enabled ? Palette.soft-disabled : touch.pressed ? (primary ? Palette.accent-fill-pressed : Palette.soft-pressed) : (primary ? Palette.accent-fill : Palette.soft);
    HorizontalLayout {
        alignment: center;
        spacing: 9px;
        if root.has-icon: Image {
            source: root.icon;
            width: 23px;
            height: 23px;
            colorize: root.enabled ? Palette.soft-text : Palette.disabled;
            image-fit: contain;
        }
        Text {
            text: root.label;
            color: !root.enabled ? Palette.disabled : root.primary ? #ffffff : Palette.soft-text;
            font-size: 17px;
            font-weight: 650;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { clicked => { if root.enabled { root.chosen(); } } }
}

component SetupQr inherits Rectangle {
    in property <[bool]> modules;
    in property <int> module-count;
    in property <image> image;
    in property <color> module-color: #000000;
    background: #ffffff;
    border-radius: 18px;
    if root.image.width > 0: Image {
        width: parent.width;
        height: parent.height;
        source: root.image;
        image-fit: contain;
        image-rendering: pixelated;
    }
    for module[index] in root.modules: Rectangle {
        width: parent.width / (root.module-count + 4);
        height: self.width;
        x: (Math.mod(index, root.module-count) + 2) * self.width;
        y: (Math.floor(index / root.module-count) + 2) * self.height;
        background: module ? root.module-color : transparent;
    }
}

component WifiSignal inherits Rectangle {
    in property <int> strength;
    width: 62px;
    height: 28px;
    for bar[index] in 5: Rectangle {
        x: index * 12px;
        y: parent.height - self.height;
        width: 8px;
        height: 8px + index * 4px;
        border-radius: 3px;
        background: index < root.strength ? Palette.signal-on : Palette.signal-off;
        border-width: 1px;
        border-color: index < root.strength ? Palette.signal-on : Palette.signal-off-line;
    }
}

export component CommissioningWindow inherits Window {
    default-font-family: "Inter";
    in-out property <string> color-scheme <=> Palette.scheme;
    in-out property <bool> increased-contrast <=> Palette.increased-contrast;
    in-out property <bool> reduced-motion <=> Palette.reduced-motion;
    in property <int> viewport-width: 800;
    in property <int> viewport-height: 1280;
    in property <string> stage: "wifi";
    in property <[WifiItem]> wifi-networks: [];
    in property <[InstanceItem]> instances: [];
    in property <string> input-value: "";
    in property <string> input-display-value: "";
    in property <int> input-cursor-offset: 0;
    in property <bool> input-valid-url: false;
    in property <string> selected-wifi: "";
    in property <string> selected-instance: "";
    in property <string> error-message: "";
    in property <[bool]> qr-modules: [];
    in property <int> qr-size: 0;
    in property <image> qr-image;
    in property <string> login-code: "";
    // The tablet waits for approval in Home Assistant (plan 004): its name and the code.
    in property <string> pairing-name: "";
    in property <string> pairing-code: "";
    in property <string> theme-choice: "dark";
    in property <bool> static-ip: false;
    in property <bool> demo-controls: false;
    in property <bool> german: false;
    // Language and step progress belong to first-run commissioning, never reconnect/boot status.
    in property <bool> oobe: true;
    in-out property <bool> dark-mode <=> Palette.dark;
    in property <bool> landscape: false;
    in property <string> network-link: "wifi";
    in property <string> clock-time: "--:--";

    callback wifi-selected(int);
    callback instance-selected(int);
    callback manual-url();
    callback retry();
    callback key-pressed(string);
    callback browser-login();
    callback toggle-language();
    callback theme-chosen(string);
    callback theme-continue();
    callback toggle-static-ip();
    callback input-cursor-positioned(int);

    background: root.stage == "boot" ? #0c1d27 : Palette.page;
    width: root.viewport-width * 1px;
    height: root.viewport-height * 1px;
    if root.stage == "boot": Rectangle {
        background: #0c1d27;
        Image {
            width: min(parent.width * 0.72, parent.height * 0.64);
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: @image-url("../../../assets/brand/boot.svg");
            image-fit: contain;
        }
    }
    if root.stage != "boot": VerticalLayout {
        padding-left: root.landscape ? 34px : 22px;
        padding-right: root.landscape ? 34px : 22px;
        padding-top: root.landscape ? 18px : 14px;
        padding-bottom: root.landscape ? 22px : 18px;
        spacing: 12px;

        Rectangle {
            height: root.oobe && root.width < 760px ? 116px : 72px;
            background: transparent;
            Image {
                source: Palette.dark ? @image-url("../../../assets/brand/wordmark-dark.svg") : @image-url("../../../assets/brand/wordmark-light.svg");
                x: 0px;
                width: root.landscape ? 174px : 152px;
                height: self.width / 2.7143;
                y: (64px - self.height) / 2;
                image-fit: contain;
            }
            if root.oobe: Rectangle {
                x: root.width < 760px ? 0px : (parent.width - self.width) / 2;
                y: root.width < 760px ? 64px : 0px;
                width: 318px;
                height: 52px;
                background: transparent;
                LanguageSelector {
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    german: root.german;
                    toggle-language => { root.toggle-language(); }
                }
                setup-progress := Text {
                    x: 264px;
                    width: 54px;
                    y: (parent.height - self.height) / 2;
                    height: self.preferred-height;
                    text: root.stage == "theme" || root.stage == "wifi" || root.stage == "password" || root.stage == "connecting" || root.stage == "ip-address" || root.stage == "ip-prefix" || root.stage == "ip-gateway" || root.stage == "ip-dns" ? "1 / 3"
                        : root.stage == "discovery" || root.stage == "discovering" || root.stage == "manual" || root.stage == "authorizing" ? "2 / 3" : "3 / 3";
                    color: Palette.muted;
                    font-size: 16px;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                x: parent.width - self.width;
                width: 30px + 12px + status-clock.preferred-width;
                y: 0px;
                height: 64px;
                background: transparent;
                HorizontalLayout {
                    alignment: end;
                    spacing: 12px;
                    Rectangle {
                        width: 30px;
                        Image {
                            y: (parent.height - self.height) / 2;
                            width: 30px;
                            height: 30px;
                            source: root.network-link == "ethernet" ? @image-url("../../../assets/icons/ethernet.svg")
                                : root.network-link == "wifi1" ? @image-url("../../../assets/icons/wifi-strength-1.svg")
                                : root.network-link == "wifi2" ? @image-url("../../../assets/icons/wifi-strength-2.svg")
                                : root.network-link == "wifi3" ? @image-url("../../../assets/icons/wifi-strength-3.svg")
                                : root.network-link == "wifi4" ? @image-url("../../../assets/icons/wifi-strength-4.svg")
                                : @image-url("../../../assets/icons/wifi.svg");
                            colorize: Palette.icon;
                            image-fit: contain;
                        }
                    }
                    status-clock := Text {
                        width: self.preferred-width;
                        text: root.clock-time;
                        color: Palette.text;
                        font-size: 22px;
                        font-weight: 650;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.stage == "theme": VerticalLayout {
            spacing: 14px;
            Text { text: root.german ? "Darstellung wählen" : "Choose the appearance"; color: Palette.text; font-size: root.landscape ? 32px : 30px; font-weight: 650; }
            Text {
                text: root.german ? "Du kannst das später in Home Assistant ändern." : "You can change this later in Home Assistant.";
                color: Palette.muted;
                font-size: 18px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 12px;
                ChoiceButton {
                    height: 76px;
                    label: root.german ? "Hell" : "Light";
                    selected: root.theme-choice == "light";
                    dark-mode: Palette.dark;
                    clicked => { root.theme-chosen("light"); }
                }
                ChoiceButton {
                    height: 76px;
                    label: root.german ? "Dunkel" : "Dark";
                    selected: root.theme-choice == "dark";
                    dark-mode: Palette.dark;
                    clicked => { root.theme-chosen("dark"); }
                }
                ChoiceButton {
                    height: 76px;
                    label: root.german ? "Automatisch" : "Automatic";
                    selected: root.theme-choice == "automatic";
                    dark-mode: Palette.dark;
                    clicked => { root.theme-chosen("automatic"); }
                }
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
            SetupButton {
                primary: true;
                label: root.german ? "Weiter" : "Continue";
                chosen => { root.theme-continue(); }
            }
        }

        if root.stage == "wifi": VerticalLayout {
            spacing: 14px;
            Text { text: root.german ? "Mit WLAN verbinden" : "Connect to Wi-Fi"; color: Palette.text; font-size: root.landscape ? 32px : 30px; font-weight: 650; }
            Text { text: root.german ? "Wähle das Netzwerk für dieses Panel." : "Choose the network this panel should use."; color: Palette.muted; font-size: 18px; }
            if root.error-message != "": Text { text: root.error-message; color: Palette.error; font-size: 16px; wrap: word-wrap; }
            Flickable {
                vertical-stretch: 1;
                content-width: self.width;
                content-height: root.wifi-networks.length * 76px;
                for network[index] in root.wifi-networks: Rectangle {
                    y: index * 76px;
                    width: parent.width;
                    height: 64px;
                    border-radius: 17px;
                    background: wifi-touch.pressed ? Palette.surface-pressed : Palette.surface;
                    border-width: 1px;
                    border-color: Palette.border;
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        spacing: 12px;
                        Rectangle {
                            width: 62px;
                            background: transparent;
                            WifiSignal {
                                y: (parent.height - self.height) / 2;
                                strength: network.signal;
                            }
                        }
                        Text { text: network.name; color: Palette.text; font-size: 21px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: network.secured ? (root.german ? "Geschützt" : "Locked") : (root.german ? "Offen" : "Open"); color: Palette.muted; font-size: 16px; vertical-alignment: center; }
                    }
                    wifi-touch := TouchArea { clicked => { root.wifi-selected(index); } }
                }
            }
            ChoiceButton {
                height: 50px;
                label: root.static-ip
                    ? (root.german ? "Feste IP-Adresse: an" : "Fixed IP address: on")
                    : (root.german ? "Feste IP-Adresse: aus (DHCP)" : "Fixed IP address: off (DHCP)");
                selected: root.static-ip;
                dark-mode: Palette.dark;
                clicked => { root.toggle-static-ip(); }
            }
        }

        if root.stage == "password" || root.stage == "manual" || root.stage == "ip-address" || root.stage == "ip-prefix" || root.stage == "ip-gateway" || root.stage == "ip-dns": VerticalLayout {
            spacing: 10px;
            if root.stage == "manual": Rectangle {
                vertical-stretch: 1;
                background: transparent;
            }
            Text {
                text: root.stage == "password"
                    ? (root.german ? "WLAN-Passwort eingeben" : "Enter Wi-Fi password")
                    : root.stage == "ip-address" ? (root.german ? "IP-Adresse des Panels" : "IP address of this panel")
                    : root.stage == "ip-prefix" ? (root.german ? "Länge des Netzpräfixes" : "Subnet prefix length")
                    : root.stage == "ip-gateway" ? (root.german ? "Router (Gateway)" : "Router (gateway)")
                    : root.stage == "ip-dns" ? (root.german ? "DNS-Server" : "DNS servers")
                    : (root.german ? "Home Assistant wurde nicht gefunden." : "Home Assistant was not found.");
                color: Palette.text;
                font-size: root.landscape ? 27px : 25px;
                font-weight: 650;
            }
            Text {
                text: root.stage == "password" ? root.selected-wifi
                    : root.stage == "ip-address" ? (root.german ? "Zum Beispiel 192.168.1.50" : "For example 192.168.1.50")
                    : root.stage == "ip-prefix" ? (root.german ? "24 entspricht 255.255.255.0" : "24 means 255.255.255.0")
                    : root.stage == "ip-gateway" ? (root.german ? "Zum Beispiel 192.168.1.1" : "For example 192.168.1.1")
                    : root.stage == "ip-dns" ? (root.german ? "Keiner oder bis zu zwei, mit Leerzeichen getrennt" : "None, or up to two, separated by spaces")
                    : (root.german ? "URL eingeben" : "Enter URL");
                color: Palette.muted;
                font-size: 16px;
            }
            Rectangle {
                height: 58px;
                border-radius: 15px;
                background: Palette.surface;
                border-width: 2px;
                border-color: root.error-message == "" ? Palette.accent-line : Palette.error-line;
                if root.stage == "manual" && root.input-value == "": Text {
                    x: 16px;
                    width: parent.width - 32px;
                    height: parent.height;
                    text: "https://homeassistant.local:8123";
                    color: Palette.placeholder;
                    font-size: 18px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                commissioning-input := TextInput {
                    x: 16px;
                    width: parent.width - 32px;
                    height: parent.height;
                    text: root.input-value;
                    color: Palette.text;
                    font-size: 18px;
                    line-height-factor: 1.2;
                    vertical-alignment: center;
                    single-line: true;
                    read-only: true;
                    input-type: root.stage == "password" ? password : text;
                    text-cursor-width: 2px;
                    in property <int> requested-cursor-offset: root.input-cursor-offset;
                    init => {
                        self.focus();
                        self.set-selection-offsets(requested-cursor-offset, requested-cursor-offset);
                    }
                    changed requested-cursor-offset => {
                        self.set-selection-offsets(requested-cursor-offset, requested-cursor-offset);
                    }
                    cursor-position-changed(_) => {
                        root.input-cursor-positioned(self.cursor-position-byte-offset);
                    }
                }
                // Keep the password mask in the glyph subset embedded for
                // software-rendered targets that cannot fall back to OS fonts.
                Text { visible: false; text: "•"; }
            }
            if root.error-message != "": Text { text: root.error-message; color: Palette.error; font-size: 14px; }
            if root.stage == "manual": HorizontalLayout {
                spacing: 12px;
                SetupButton {
                    horizontal-stretch: 1;
                    label: root.german ? "Neu suchen" : "Rescan";
                    has-icon: true;
                    icon: @image-url("../../../assets/icons/reload.svg");
                    chosen => { root.retry(); }
                }
                SetupButton {
                    horizontal-stretch: 1;
                    label: root.german ? "Verbinden" : "Connect";
                    primary: true;
                    enabled: root.input-valid-url;
                    chosen => { root.key-pressed("submit"); }
                }
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
            VirtualKeyboard {
                height: root.landscape && root.height < 700px
                    ? (root.error-message == "" ? 252px : 220px) : 312px;
                german: root.german;
                key-pressed(value) => { root.key-pressed(value); }
            }
        }

        if root.stage == "connecting" || root.stage == "discovering" || root.stage == "authorizing" || root.stage == "loading": VerticalLayout {
            alignment: center;
            spacing: 18px;
            Rectangle { vertical-stretch: 1; background: transparent; }
            Rectangle {
                height: 28px;
                background: transparent;
                SetupProgressIndicator {
                    x: (parent.width - self.width) / 2;
                }
            }
            Text {
                text: root.stage == "connecting"
                    ? (root.german ? "WLAN wird verbunden …" : "Connecting to Wi-Fi…")
                    : root.stage == "discovering"
                        ? (root.german ? "Home Assistant wird gesucht …" : "Looking for Home Assistant…")
                        : root.stage == "loading"
                            ? (root.german ? "Dein Zuhause wird geladen …" : "Loading your home…")
                            : (root.german ? "Home Assistant wird kontaktiert …" : "Contacting Home Assistant…");
                color: Palette.text;
                font-size: root.landscape ? 29px : 27px;
                font-weight: 650;
                horizontal-alignment: center;
            }
            Text {
                text: root.stage == "connecting" ? root.selected-wifi : root.selected-instance;
                color: Palette.muted;
                font-size: 18px;
                horizontal-alignment: center;
            }
            if root.error-message != "": Text {
                text: root.error-message;
                color: Palette.error;
                font-size: 16px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
        }

        if root.stage == "discovery": VerticalLayout {
            spacing: 14px;
            Text { text: root.german ? "Home Assistant auswählen" : "Choose Home Assistant"; color: Palette.text; font-size: root.landscape ? 30px : 28px; font-weight: 650; }
            Text { text: root.german ? "Wähle eine gefundene Installation oder gib ihre Adresse ein." : "Select a detected installation or enter its address manually."; color: Palette.muted; font-size: 17px; wrap: word-wrap; }
            if root.error-message != "": Text { text: root.error-message; color: Palette.error; font-size: 15px; wrap: word-wrap; }
            Flickable {
                vertical-stretch: 1;
                content-width: self.width;
                content-height: max(self.height, root.instances.length * 92px);
                for instance[index] in root.instances: Rectangle {
                    y: index * 92px;
                    width: parent.width;
                    height: 80px;
                    border-radius: 18px;
                    background: instance-touch.pressed ? Palette.surface-pressed : Palette.surface;
                    border-width: 1px;
                    border-color: Palette.border;
                    VerticalLayout {
                        padding: 13px;
                        spacing: 3px;
                        Text { text: instance.name; color: Palette.text; font-size: 20px; font-weight: 600; }
                        Text { text: instance.endpoint; color: Palette.muted; font-size: 14px; overflow: elide; }
                    }
                    instance-touch := TouchArea { clicked => { root.instance-selected(index); } }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                SetupButton { label: root.german ? "Neu suchen" : "Rescan"; chosen => { root.retry(); } }
                SetupButton { label: root.german ? "URL eingeben" : "Enter URL"; chosen => { root.manual-url(); } }
            }
        }

        if root.stage == "pairing": VerticalLayout {
            alignment: center;
            spacing: 14px;
            Text { text: root.german ? "In Home Assistant freigeben" : "Approve in Home Assistant"; color: Palette.text; font-size: root.landscape ? 34px : 28px; font-weight: 650; horizontal-alignment: center; wrap: word-wrap; }
            Text { text: root.pairing-name; color: Palette.accent; font-size: 20px; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
            if root.pairing-code != "": Text { text: root.pairing-code; color: Palette.text; font-size: root.landscape ? 72px : 64px; font-weight: 700; horizontal-alignment: center; }
            Text { text: root.german ? "Öffne Home Assistant, dann Einstellungen, Geräte & Dienste, Entdeckt. Gib das Tablet frei, wenn der Code übereinstimmt." : "Open Home Assistant, then Settings, Devices & services, Discovered. Approve the tablet if the code matches."; color: Palette.muted; font-size: 19px; horizontal-alignment: center; wrap: word-wrap; }
            Text { text: root.error-message == "" ? (root.german ? "Warte auf Freigabe …" : "Waiting for approval …") : root.error-message; color: root.error-message == "" ? Palette.subtle : Palette.error; font-size: 17px; horizontal-alignment: center; wrap: word-wrap; }
            Rectangle {
                height: 54px;
                background: transparent;
                SetupButton {
                    x: (parent.width - self.width) / 2;
                    width: 310px;
                    height: 54px;
                    label: root.german ? "Andere Installation wählen" : "Choose another installation";
                    chosen => { root.retry(); }
                }
            }
        }

        if root.stage == "browser" && root.landscape: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            HorizontalLayout {
                spacing: 52px;
                alignment: center;
                Rectangle {
                    width: 360px;
                    height: 360px;
                    background: transparent;
                    SetupQr {
                        y: -10px;
                        width: 360px;
                        height: 360px;
                        modules: root.qr-modules;
                        image: root.qr-image;
                        module-count: root.qr-size;
                    }
                }
                VerticalLayout {
                    max-width: 540px;
                    spacing: 18px;
                    Text { text: root.german ? "Auf dem Smartphone anmelden" : "Sign in on your phone"; color: Palette.text; font-size: 34px; font-weight: 650; wrap: word-wrap; }
                    Text { text: root.german ? "Scanne den QR-Code. Home Assistant öffnet sich im Browser und kehrt nach der Freigabe hierher zurück." : "Scan the QR code. Home Assistant opens in your browser and returns here after approval."; color: Palette.muted; font-size: 20px; wrap: word-wrap; }
                    Text { text: root.selected-instance; color: Palette.accent; font-size: 18px; font-weight: 600; wrap: word-wrap; }
                    Text { text: (root.german ? "Sitzung " : "Session ") + root.login-code; color: Palette.text; font-size: 23px; font-weight: 650; }
                    Text { text: root.error-message == "" ? (root.german ? "Warte auf den Browser…" : "Waiting for browser…") : root.error-message; color: root.error-message == "" ? Palette.subtle : Palette.error; font-size: 17px; wrap: word-wrap; }
                    if root.demo-controls: SetupButton { label: root.german ? "Browser-Freigabe simulieren" : "Simulate browser approval"; primary: true; chosen => { root.browser-login(); } }
                    if root.error-message != "": SetupButton { label: root.german ? "Andere Installation wählen" : "Choose another installation"; chosen => { root.retry(); } }
                }
            }
        }

        if root.stage == "browser" && !root.landscape: VerticalLayout {
            alignment: center;
            spacing: 11px;
            Text { text: root.german ? "Auf dem Smartphone anmelden" : "Sign in on your phone"; color: Palette.text; font-size: 28px; font-weight: 650; horizontal-alignment: center; }
            Text { text: root.german ? "Scanne den QR-Code, um in Home Assistant fortzufahren." : "Scan the QR code to continue in Home Assistant."; color: Palette.muted; font-size: 17px; horizontal-alignment: center; wrap: word-wrap; }
            Rectangle {
                height: 330px;
                background: transparent;
                SetupQr {
                    x: (parent.width - self.width) / 2;
                    width: 330px;
                    height: 330px;
                    modules: root.qr-modules;
                    image: root.qr-image;
                    module-count: root.qr-size;
                }
            }
            Text { text: root.selected-instance; color: Palette.accent; font-size: 16px; font-weight: 600; horizontal-alignment: center; }
            Text { text: (root.german ? "Sitzung " : "Session ") + root.login-code; color: Palette.text; font-size: 20px; font-weight: 650; horizontal-alignment: center; }
            Text { text: root.error-message == "" ? (root.german ? "Warte auf den Browser…" : "Waiting for browser…") : root.error-message; color: root.error-message == "" ? Palette.subtle : Palette.error; font-size: 16px; horizontal-alignment: center; wrap: word-wrap; }
            if root.demo-controls: Rectangle {
                height: 54px;
                background: transparent;
                SetupButton {
                    x: (parent.width - self.width) / 2;
                    width: 310px;
                    height: 54px;
                    label: root.german ? "Browser-Freigabe simulieren" : "Simulate browser approval";
                    primary: true;
                    chosen => { root.browser-login(); }
                }
            }
            if root.error-message != "": Rectangle {
                height: 54px;
                background: transparent;
                SetupButton {
                    x: (parent.width - self.width) / 2;
                    width: 310px;
                    height: 54px;
                    label: root.german ? "Andere Installation wählen" : "Choose another installation";
                    chosen => { root.retry(); }
                }
            }
        }

    }
}
