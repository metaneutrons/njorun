export enum EntityIcon {
    Lightbulb,
    Power,
    Play,
    Thermometer,
    Sensor,
    BinarySensor,
}

export struct TileItem {
    entity-id: string,
    name: string,
    value: string,
    icon: EntityIcon,
    active: bool,
    pending: bool,
    failed: bool,
    unavailable: bool,
    stale: bool,
    command-enabled: bool,
}

export struct RoomItem {
    id: string,
    name: string,
    summary: string,
}

export struct DetailsItem {
    entity-id: string,
    name: string,
    value: string,
    update-time: string,
    reason: string,
    attributes: string,
    icon: EntityIcon,
    unavailable: bool,
}

component RoomShortcut inherits Rectangle {
    in property <RoomItem> item;
    in property <bool> dark-mode;
    in property <bool> selected;
    in property <bool> compact;
    callback chosen();
    callback activity();

    accessible-role: button;
    accessible-label: item.name;
    accessible-description: item.summary;
    accessible-action-default => { root.chosen(); }
    height: 58px;
    border-radius: compact ? 16px : 22px;
    background: touch-area.pressed ? (dark-mode ? #284a54 : #dcece7) : selected
        ? (dark-mode ? #234b57 : #d9f2eb)
        : (dark-mode ? #142d3a : #ffffff);
    border-width: selected ? 1.5px : 1px;
    border-color: selected
        ? (dark-mode ? #75e0c2 : #318a79)
        : (dark-mode ? #294b57 : #dce7e4);

    HorizontalLayout {
        padding: compact ? 10px : 16px;
        padding-top: compact ? 4px : 12px;
        padding-bottom: compact ? 4px : 12px;
        spacing: 12px;
        Rectangle {
            width: compact ? 25px : 30px;
            Image {
                source: @image-url("../../../assets/icons/home-outline.svg");
                width: compact ? 25px : 30px;
                height: compact ? 25px : 30px;
                colorize: dark-mode ? #75e0c2 : #367d70;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: compact ? 2px : 7px;
            Text {
                text: item.name;
                color: dark-mode ? #edf8f5 : #17323d;
                font-size: compact ? 18px : 22px;
                wrap: word-wrap;
                max-lines: 2;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            if !compact: Text {
                text: item.summary;
                color: dark-mode ? #9ab3ba : #566d73;
                font-size: 16px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    touch-area := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.activity(); }
        }
        clicked => { root.chosen(); }
    }
}

component EntityTile inherits Rectangle {
    in property <TileItem> item;
    in property <bool> dark-mode;
    in property <bool> german;
    callback activate();
    callback request-details();
    callback activity();

    private property <string> pressed-id: "";
    private property <bool> hold-cancelled: false;
    private property <bool> hold-consumed: false;
    private property <bool> tap-cancelled: false;

    accessible-role: button;
    accessible-label: item.name;
    accessible-description: item.value;
    accessible-action-default => { root.activate(); }
    private property <color> icon-color: item.active
        ? (dark-mode ? #a8eee1 : #225f53)
        : (dark-mode ? #abbfc3 : #536b72);
    border-radius: 22px;
    border-width: 1px;
    border-color: dark-mode ? #294b57 : #dce7e4;
    background: touch-area.pressed && !root.tap-cancelled
        ? (dark-mode ? #234650 : #e1efea) : (dark-mode ? #142d3a : #ffffff);

    HorizontalLayout {
        padding: 14px;
        padding-right: 50px;
        spacing: 10px;
        Rectangle {
            width: 44px;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 14px;
                background: item.active ? (dark-mode ? #215547 : #d8eee3)
                    : (dark-mode ? #233b46 : #eef2f2);
                if item.icon == EntityIcon.Lightbulb: Image {
                    source: @image-url("../../../assets/icons/lightbulb.svg");
                    width: 28px;
                    height: 28px;
                    colorize: root.icon-color;
                }
                if item.icon == EntityIcon.Power: Image {
                    source: @image-url("../../../assets/icons/power.svg");
                    width: 28px;
                    height: 28px;
                    colorize: root.icon-color;
                }
                if item.icon == EntityIcon.Play: Image {
                    source: @image-url("../../../assets/icons/play.svg");
                    width: 28px;
                    height: 28px;
                    colorize: root.icon-color;
                }
                if item.icon == EntityIcon.Thermometer: Image {
                    source: @image-url("../../../assets/icons/thermometer.svg");
                    width: 28px;
                    height: 28px;
                    colorize: root.icon-color;
                }
                if item.icon == EntityIcon.Sensor: Image {
                    source: @image-url("../../../assets/icons/information-outline.svg");
                    width: 28px;
                    height: 28px;
                    colorize: root.icon-color;
                }
                if item.icon == EntityIcon.BinarySensor: Image {
                    source: @image-url("../../../assets/icons/checkbox-blank-circle-outline.svg");
                    width: 28px;
                    height: 28px;
                    colorize: root.icon-color;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 5px;
            Text {
                text: item.name;
                color: dark-mode ? #edf8f5 : #17323d;
                font-size: 22px;
                wrap: word-wrap;
                max-lines: 2;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                width: 100%;
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 8px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: item.failed
                            ? #e58d7b
                            : item.pending
                                ? #f0cb8d
                                : item.active
                                    ? (dark-mode ? #75e0c2 : #318a79)
                                    : (dark-mode ? #849ba2 : #71878a);
                    }
                }
                Text {
                    text: item.value;
                    color: item.failed
                        ? (dark-mode ? #ffc1b5 : #a73f35)
                        : item.pending
                            ? (dark-mode ? #f0cb8d : #94620d)
                            : item.unavailable || item.stale
                                ? (dark-mode ? #b1c3c7 : #657a80)
                                : (dark-mode ? #bdd3d4 : #415c63);
                    font-size: 17px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    max-lines: 2;
                    overflow: elide;
                    min-width: 0px;
                    horizontal-stretch: 1;
                }
            }
        }
    }

    touch-area := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.pressed-id = item.entity-id;
                root.hold-cancelled = false;
                root.hold-consumed = false;
                root.tap-cancelled = false;
                root.activity();
            } else if event.kind == PointerEventKind.cancel {
                root.hold-cancelled = true;
                root.tap-cancelled = true;
            }
        }
        moved => {
            if abs(self.mouse-x - self.pressed-x) > 16px || abs(self.mouse-y - self.pressed-y) > 16px {
                root.hold-cancelled = true;
                root.tap-cancelled = true;
                root.activity();
            }
        }
        clicked => {
            if root.hold-consumed {
                root.hold-consumed = false;
            } else if !root.tap-cancelled && root.pressed-id == item.entity-id {
                root.activate();
            }
            root.tap-cancelled = false;
            root.pressed-id = "";
        }
    }

    Timer {
        interval: 620ms;
        running: touch-area.pressed && root.pressed-id == item.entity-id && !root.hold-cancelled && !root.hold-consumed;
        triggered => {
            if !root.hold-cancelled {
                root.hold-consumed = true;
                root.request-details();
            }
        }
    }

    Rectangle {
        accessible-role: button;
        accessible-label: (root.german ? "Details zu " : "Details for ") + item.name;
        accessible-action-default => { root.request-details(); }
        background: info-touch.pressed ? (dark-mode ? #27444c : #e4eeea) : transparent;
        x: parent.width - 54px;
        y: (parent.height - self.height) / 2;
        width: 48px;
        height: 48px;
        border-radius: 16px;
        Image {
            source: @image-url("../../../assets/icons/information-outline.svg");
            width: 21px;
            height: 21px;
            colorize: dark-mode ? #b8d1d3 : #536b72;
        }
        info-touch := TouchArea {
            clicked => { root.request-details(); }
        }
    }
}

// Keep a stable column width even when a room or favorites has only one tile.
component CardGrid inherits Flickable {
    in property <int> columns: 1;
    in property <int> item-count;
    out property <length> row-height: 128px;
    in property <length> gap;
    out property <length> cell-width: (self.width - (columns - 1) * gap) / columns;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    content-width: self.width;
    content-height: max(self.height, Math.ceil(item-count / columns) * (row-height + gap) - gap);
}

component EntityGrid inherits CardGrid {
    in property <[TileItem]> items;
    in property <bool> dark-mode;
    in property <bool> german;
    callback activate(string);
    callback request-details(string);
    callback activity();
    item-count: items.length;
    for tile[index] in root.items: EntityTile {
        width: root.cell-width;
        height: root.row-height;
        x: Math.mod(index,root.columns) * (self.width + root.gap);
        y: Math.floor(index / root.columns) * (root.row-height + root.gap);
        item: tile;
        dark-mode: root.dark-mode;
        german: root.german;
        activate => { root.activate(tile.entity-id); }
        request-details => { root.request-details(tile.entity-id); }
        activity => { root.activity(); }
    }
}

component RoomGrid inherits CardGrid {
    in property <[RoomItem]> rooms;
    in property <bool> dark-mode;
    callback selected(int);
    callback activity();
    item-count: rooms.length;
    for room[index] in root.rooms: RoomShortcut {
        width: root.cell-width;
        height: root.row-height;
        x: Math.mod(index, root.columns) * (self.width + root.gap);
        y: Math.floor(index / root.columns) * (root.row-height + root.gap);
        item: room;
        dark-mode: root.dark-mode;
        chosen => { root.selected(index); }
        activity => { root.activity(); }
    }
}

component EmptyState inherits Rectangle {
    in property <bool> dark-mode;
    in property <bool> german;
    in property <string> title;
    in property <string> description;
    height: body.preferred-height;
    border-radius: 22px;
    background: dark-mode ? #142d3a : #ffffff;
    border-width: 1px;
    border-color: dark-mode ? #294b57 : #dce7e4;
    body := VerticalLayout {
        padding: 24px;
        spacing: 10px;
        Image {
            source: @image-url("../../../assets/icons/home-outline.svg");
            width: 29px;
            height: 29px;
            colorize: dark-mode ? #75e0c2 : #367d70;
        }
        Text {
            text: root.title;
            color: dark-mode ? #edf8f5 : #17323d;
            font-size: 18px;
            font-weight: 600;
            wrap: word-wrap;
        }
        Text {
            text: root.description;
            color: dark-mode ? #9ab3ba : #566d73;
            font-size: 14px;
            wrap: word-wrap;
        }
    }
}

component HomeButton inherits Rectangle {
    in property <bool> german;
    in property <bool> dark-mode;
    callback chosen();
    accessible-role: button;
    accessible-label: german ? "Startseite" : "Home";
    accessible-action-default => { root.chosen(); }
    width: 144px;
    height: 58px;
    border-radius: 16px;
    background: touch.pressed ? (dark-mode ? #284a54 : #cbe6de) : (dark-mode ? #193d43 : #e0f2eb);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Rectangle {
            width: 30px;
            Image {
                width: 30px;
                height: 30px;
                source: @image-url("../../../assets/icons/home-outline.svg");
                colorize: dark-mode ? #a8eee1 : #28675c;
            }
        }
        Text {
            text: root.german ? "Startseite" : "Home";
            font-size: 18px;
            font-weight: 600;
            color: dark-mode ? #edf8f5 : #17323d;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.chosen(); } }
}

component NavigationButton inherits Rectangle {
    in property <string> label;
    in property <bool> dark-mode;
    callback chosen();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.chosen(); }
    height: 48px;
    min-width: 104px;
    border-radius: 15px;
    background: nav-touch.pressed ? (dark-mode ? #284a54 : #cbe6de) : (dark-mode ? #193d43 : #e0f2eb);
    Text {
        text: root.label;
        color: dark-mode ? #bde8db : #28675c;
        font-size: 13px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    nav-touch := TouchArea { clicked => { root.chosen(); } }
}

export component MainWindow inherits Window {
    in property <[TileItem]> tiles: [];
    in property <[TileItem]> favorites: [];
    in property <[RoomItem]> rooms: [];
    in property <int> selected-room: -1;
    in property <string> home-view: "rooms";
    in property <bool> rooms-page: false;
    in property <DetailsItem> details-data;
    in property <bool> dark-mode: false;
    in property <bool> german: false;
    in property <bool> boot-screen: true;
    in property <bool> connection-ready: false;
    in property <string> network-link: "";
    in property <bool> management-degraded: false;
    private property <bool> inspect-status: false;
    in property <bool> command-warning: false;
    in property <string> connection-text: "";
    in property <bool> details-open: false;
    in property <bool> details-fullscreen: false;
    in property <bool> display-off: false;
    in property <bool> show-clock: false;
    in property <string> clock-time: "00:00";
    in property <float> display-dim-opacity: 0;

    private property <bool> landscape: self.width > self.height;
    private property <bool> has-selected-room: root.selected-room >= 0 && root.selected-room < root.rooms.length;
    private property <bool> show-favorite-grid: !root.has-selected-room && !root.rooms-page && root.home-view != "rooms" && root.favorites.length > 0;
    private property <bool> show-page-heading: !root.has-selected-room && (root.home-view != "mixed" || root.rooms-page);
    private property <bool> show-room-grid: !root.has-selected-room && root.rooms.length > 0 && (root.home-view == "rooms" || root.rooms-page || root.home-view == "mixed");
    private property <bool> show-empty-state: root.has-selected-room
        ? root.tiles.length == 0
        : root.home-view == "favorites"
            ? (root.rooms-page ? root.rooms.length == 0 : root.favorites.length == 0)
            : root.home-view == "mixed"
                ? root.favorites.length == 0 && root.rooms.length == 0
                : root.rooms.length == 0;
    private property <int> tile-columns: self.width > 1080px ? 3 : self.width > 620px ? 2 : 1;
    private property <int> favorite-row-count: (root.favorites.length + root.tile-columns - 1) / root.tile-columns;
    private property <bool> indicator-phase: false;

    callback activate-entity(string);
    callback request-details(string);
    callback room-selected(int);
    callback show-rooms();
    callback go-home();
    callback activity();
    callback wake-display();
    callback dismiss-details();

    title: "Njörun";
    background: dark-mode ? #0c1d27 : #f1f6f4;
    min-width: 440px;
    min-height: 600px;

    Timer {
        interval: 900ms;
        running: !root.connection-ready;
        triggered => { root.indicator-phase = !root.indicator-phase; }
    }

    if boot-screen: Rectangle {
        background: #0c1d27;
        VerticalLayout {
            alignment: center;
            spacing: 20px;
            Image {
                source: @image-url("../../../assets/brand/boot.svg");
                image-fit: contain;
                width: min(parent.width * 0.82, parent.height * 0.74);
                height: min(parent.width * 0.82, parent.height * 0.74);
            }
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.indicator-phase ? #75e0c2 : #2d7f76;
                }
                Text {
                    text: root.connection-text == ""
                        ? (root.german ? "Njörun startet" : "Starting Njörun")
                        : root.connection-text;
                    color: #a8c4c7;
                    font-size: 15px;
                    vertical-alignment: center;
                }
            }
        }
    }
    if !boot-screen: VerticalLayout {
        spacing: 0px;
        padding: landscape ? 20px : 14px;
        padding-top: 0px;

        HorizontalLayout {
            height: landscape ? 88px : 76px;
            spacing: 14px;
            Rectangle {
                width: landscape ? 174px : 152px;
                Image {
                    source: root.dark-mode
                        ? @image-url("../../../assets/brand/wordmark-dark.svg")
                        : @image-url("../../../assets/brand/wordmark-light.svg");
                    width: parent.width;
                    height: 58px;
                    y: (parent.height - self.height) / 2;
                    image-fit: contain;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.network-link != "": Rectangle {
                width: 24px;
                accessible-role: image;
                accessible-label: root.network-link == "ethernet" ? "Ethernet" : "Wi-Fi";
                Image {
                    width: 22px; height: 22px;
                    source: root.network-link == "ethernet" ? @image-url("../../../assets/icons/ethernet.svg")
                        : root.network-link == "wifi1" ? @image-url("../../../assets/icons/wifi-strength-1.svg")
                        : root.network-link == "wifi2" ? @image-url("../../../assets/icons/wifi-strength-2.svg")
                        : root.network-link == "wifi3" ? @image-url("../../../assets/icons/wifi-strength-3.svg")
                        : root.network-link == "wifi4" ? @image-url("../../../assets/icons/wifi-strength-4.svg")
                        : @image-url("../../../assets/icons/wifi.svg");
                    colorize: root.dark-mode ? #bdd3d4 : #415c63;
                }
            }
            Rectangle {
                width: 44px;
                accessible-role: button;
                accessible-label: root.connection-text;
                Image {
                    width: 22px; height: 22px;
                    source: root.management-degraded ? @image-url("../../../assets/icons/server-minus.svg")
                        : root.connection-ready ? @image-url("../../../assets/icons/server-network.svg")
                        : @image-url("../../../assets/icons/server-network-off.svg");
                    colorize: !root.connection-ready || root.management-degraded
                        ? (root.dark-mode ? #f0cb8d : #88551a) : (root.dark-mode ? #75e0c2 : #28675c);
                    opacity: !root.connection-ready && root.indicator-phase ? 0.55 : 1;
                }
                TouchArea { clicked => { root.inspect-status = !root.inspect-status; } }
            }
            Rectangle {
                width: clock-label.preferred-width;
                clock-label := Text {
                    text: root.clock-time;
                    font-size: 17px;
                    font-weight: 600;
                    height: self.preferred-height;
                    // Align the visible digits with the icon ink, allowing for font descent.
                    y: (parent.height - self.height) / 2 + 1px;
                    color: root.dark-mode ? #edf8f5 : #17323d;
                }
            }
        }

        if landscape: HorizontalLayout {
            spacing: 18px;
            if root.has-selected-room: VerticalLayout {
                width: 214px;
                spacing: 9px;
                padding-top: 12px;
                HomeButton {
                    width: parent.width;
                    german: root.german;
                    dark-mode: root.dark-mode;
                    chosen => { root.go-home(); }
                }
                Text {
                    text: root.german ? "RÄUME" : "ROOMS";
                    color: root.dark-mode ? #8eabb1 : #536970;
                    font-size: 12px;
                    font-weight: 700;
                    letter-spacing: 1.4px;
                    height: 24px;
                    vertical-alignment: center;
                }
                if root.rooms.length == 0: Text {
                    text: root.german ? "Noch keine Räume" : "No rooms yet";
                    color: root.dark-mode ? #9ab3ba : #566d73;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: root.rooms.length * 68px;
                    for room[index] in root.rooms: RoomShortcut {
                        x: 0px;
                        y: index * 68px;
                        width: parent.width;
                        item: room;
                        dark-mode: root.dark-mode;
                        selected: root.selected-room == index;
                        compact: true;
                        chosen => { root.room-selected(index); }
                        activity => { root.activity(); }
                    }
                }
            }
            if root.has-selected-room: Rectangle {
                width: 1px;
                background: root.dark-mode ? #29434d : #dce7e4;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                max-width: root.width;
                spacing: 14px;
                if root.has-selected-room: HorizontalLayout {
                    height: 58px;
                    Text {
                        text: root.rooms[root.selected-room].name;
                        color: root.dark-mode ? #edf8f5 : #17323d;
                        font-size: 27px;
                        font-weight: 650;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.rooms-page: NavigationButton {
                        label: root.german ? "‹ Räume" : "‹ Rooms";
                        dark-mode: root.dark-mode;
                        chosen => { root.room-selected(-1); }
                    }
                }
                if root.show-page-heading: HorizontalLayout {
                    height: 58px;
                    if root.rooms-page: HomeButton {
                        german: root.german;
                        dark-mode: root.dark-mode;
                        chosen => { root.go-home(); }
                    }
                    Text {
                        text: root.home-view == "favorites" && !root.rooms-page
                            ? (root.german ? "Favoriten" : "Favorites")
                            : (root.german ? "Räume" : "Rooms");
                        color: root.dark-mode ? #edf8f5 : #17323d;
                        font-size: 27px;
                        font-weight: 650;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.home-view == "favorites" && !root.rooms-page: NavigationButton {
                        label: root.german ? "Räume" : "Rooms";
                        dark-mode: root.dark-mode;
                        chosen => { root.show-rooms(); }
                    }

                }
                if root.home-view == "mixed" && root.show-favorite-grid: Text {
                    text: root.german ? "FAVORITEN" : "FAVORITES";
                    height: 20px;
                    color: root.dark-mode ? #8eabb1 : #536970;
                    font-size: 12px;
                    font-weight: 700;
                    letter-spacing: 1.4px;
                }
                if root.show-empty-state: EmptyState {
                    dark-mode: root.dark-mode;
                    german: root.german;
                    title: root.has-selected-room
                        ? (root.german ? "Keine Steuerelemente in diesem Raum" : "No controls in this room")
                        : root.home-view == "favorites" && !root.rooms-page
                            ? (root.german ? "Noch keine Favoriten" : "No favorites yet")
                            : (root.german ? "Noch keine Räume oder Steuerelemente" : "No rooms or controls yet");
                    description: root.home-view == "favorites" && !root.rooms-page
                        ? (root.german ? "Wähle Favoriten in den Njörun-Einstellungen in Home Assistant aus." : "Choose favorites in the Njörun settings in Home Assistant.")
                        : (root.german ? "Füge in Home Assistant unterstützte Lichter, Schalter, Szenen oder Sensoren zu einem Bereich hinzu." : "Add supported lights, switches, scenes or sensors to an area in Home Assistant.");
                }
                if root.has-selected-room: EntityGrid {
                    items: root.tiles;
                    columns: root.tile-columns;
                    gap: 14px;
                    dark-mode: root.dark-mode;
                    german: root.german;
                    activate(id) => { root.activate-entity(id); }
                    request-details(id) => { root.request-details(id); }
                    activity => { root.activity(); }
                }
                if root.show-favorite-grid: EntityGrid {
                    items: root.favorites;
                    columns: root.tile-columns;
                    gap: 14px;
                    dark-mode: root.dark-mode;
                    german: root.german;
                    max-height: root.home-view == "mixed" ? min(root.height * 0.42, root.favorite-row-count * 142px) : root.height;
                    activate(id) => { root.activate-entity(id); }
                    request-details(id) => { root.request-details(id); }
                    activity => { root.activity(); }
                }
                if root.home-view == "mixed" && root.show-room-grid: Text {
                    height: 20px;
                    text: root.german ? "RÄUME" : "ROOMS";
                    color: root.dark-mode ? #8eabb1 : #536970;
                    font-size: 12px;
                    font-weight: 700;
                    letter-spacing: 1.4px;
                }
                if root.show-room-grid: RoomGrid {
                    rooms: root.rooms;
                    columns: root.tile-columns;
                    gap: 14px;
                    dark-mode: root.dark-mode;
                    selected(index) => { root.room-selected(index); }
                    activity => { root.activity(); }
                }
            }
        }
        if !landscape: VerticalLayout {
            spacing: 12px;
            if root.rooms.length > 0 && root.has-selected-room: HorizontalLayout {
                height: 58px;
                spacing: 9px;
                HomeButton {
                    german: root.german;
                    dark-mode: root.dark-mode;
                    chosen => { root.go-home(); }
                }
                Flickable {
                    horizontal-stretch: 1;
                    content-width: max(self.width, root.rooms.length * 176px + max(0, root.rooms.length - 1) * 9px);
                    content-height: self.height;
                    room-tabs := HorizontalLayout {
                        width: root.rooms.length * 176px + max(0, root.rooms.length - 1) * 9px;
                        spacing: 9px;
                        for room[index] in root.rooms: RoomShortcut {
                            width: 176px;
                            item: room;
                            dark-mode: root.dark-mode;
                            selected: root.selected-room == index;
                            compact: true;
                            chosen => { root.room-selected(index); }
                            activity => { root.activity(); }
                        }
                    }
                }
            }
            if root.has-selected-room: HorizontalLayout {
                height: 48px;
                Text {
                    text: root.rooms[root.selected-room].name;
                    color: root.dark-mode ? #edf8f5 : #17323d;
                    font-size: 24px;
                    font-weight: 650;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.rooms-page: NavigationButton {
                    label: root.german ? "‹ Räume" : "‹ Rooms";
                    dark-mode: root.dark-mode;
                    chosen => { root.room-selected(-1); }
                }
            }
            if root.show-page-heading: HorizontalLayout {
                height: root.rooms-page ? 58px : 48px;
                if root.rooms-page: HomeButton {
                    german: root.german;
                    dark-mode: root.dark-mode;
                    chosen => { root.go-home(); }
                }
                Text {
                    text: root.home-view == "favorites" && !root.rooms-page
                        ? (root.german ? "Favoriten" : "Favorites")
                        : (root.german ? "Räume" : "Rooms");
                    color: root.dark-mode ? #edf8f5 : #17323d;
                    font-size: 25px;
                    font-weight: 650;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.home-view == "favorites" && !root.rooms-page: NavigationButton {
                    label: root.german ? "Räume" : "Rooms";
                    dark-mode: root.dark-mode;
                    chosen => { root.show-rooms(); }
                }

            }
            if root.home-view == "mixed" && root.show-favorite-grid: Text {
                text: root.german ? "FAVORITEN" : "FAVORITES";
                    height: 20px;
                color: root.dark-mode ? #8eabb1 : #536970;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1.4px;
            }
            if root.show-empty-state: EmptyState {
                dark-mode: root.dark-mode;
                german: root.german;
                title: root.has-selected-room
                    ? (root.german ? "Keine Steuerelemente in diesem Raum" : "No controls in this room")
                    : root.home-view == "favorites" && !root.rooms-page
                        ? (root.german ? "Noch keine Favoriten" : "No favorites yet")
                        : (root.german ? "Noch keine Räume oder Steuerelemente" : "No rooms or controls yet");
                description: root.home-view == "favorites" && !root.rooms-page
                    ? (root.german ? "Wähle Favoriten in den Njörun-Einstellungen in Home Assistant aus." : "Choose favorites in the Njörun settings in Home Assistant.")
                    : (root.german ? "Füge in Home Assistant unterstützte Lichter, Schalter, Szenen oder Sensoren zu einem Bereich hinzu." : "Add supported lights, switches, scenes or sensors to an area in Home Assistant.");
            }
            if root.has-selected-room: EntityGrid {
                items: root.tiles;
                columns: root.tile-columns;
                gap: 12px;
                dark-mode: root.dark-mode;
                german: root.german;
                activate(id) => { root.activate-entity(id); }
                request-details(id) => { root.request-details(id); }
                activity => { root.activity(); }
            }
            if root.show-favorite-grid: EntityGrid {
                items: root.favorites;
                columns: root.tile-columns;
                gap: 12px;
                dark-mode: root.dark-mode;
                german: root.german;
                max-height: root.home-view == "mixed" ? min(root.height * 0.42, root.favorite-row-count * 140px) : root.height;
                activate(id) => { root.activate-entity(id); }
                request-details(id) => { root.request-details(id); }
                activity => { root.activity(); }
            }
            if root.home-view == "mixed" && root.show-room-grid: Text {
                    height: 20px;
                text: root.german ? "RÄUME" : "ROOMS";
                color: root.dark-mode ? #8eabb1 : #536970;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1.4px;
            }
            if root.show-room-grid: RoomGrid {
                rooms: root.rooms;
                columns: root.tile-columns;
                gap: 12px;
                dark-mode: root.dark-mode;
                selected(index) => { root.room-selected(index); }
                activity => { root.activity(); }
            }
        }
    }

    if details-open: Rectangle {
        background: #00000066;
        TouchArea {
            clicked => { root.dismiss-details(); }
        }
        Rectangle {
            x: root.details-fullscreen ? 0px : root.landscape ? max(0px, root.width - 470px) : 0px;
            y: root.details-fullscreen ? 0px : root.landscape ? 0px : max(0px, root.height - 530px);
            width: root.details-fullscreen ? root.width : root.landscape ? min(470px, root.width) : root.width;
            height: root.details-fullscreen ? root.height : root.landscape ? root.height : min(530px, root.height);
            border-radius: root.details-fullscreen ? 0px : root.landscape ? 0px : 26px;
            background: root.dark-mode ? #142d3a : #ffffff;
            border-width: 1px;
            border-color: root.dark-mode ? #294b57 : #dce7e4;

            TouchArea { clicked => { } }

            VerticalLayout {
                padding: root.landscape ? 28px : 24px;
                spacing: 17px;
                HorizontalLayout {
                    spacing: 14px;
                    Rectangle {
                        width: 54px;
                        height: 54px;
                        border-radius: 18px;
                        background: root.dark-mode ? #1d414c : #e9f3f0;
                        Image {
                            source: @image-url("../../../assets/icons/information-outline.svg");
                            width: 24px;
                            height: 24px;
                            colorize: root.dark-mode ? #a8eee1 : #2e776a;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: root.german ? "Details" : "Details";
                            color: root.dark-mode ? #9ab3ba : #566d73;
                            font-size: 13px;
                        }
                        Text {
                            text: root.details-data.entity-id;
                            color: root.dark-mode ? #bdd3d4 : #415c63;
                            font-size: 13px;
                            overflow: elide;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.has-selected-room || root.rooms-page: HomeButton {
                        german: root.german;
                        dark-mode: root.dark-mode;
                        chosen => { root.go-home(); }
                    }
                    TouchArea {
                        width: 56px;
                        height: 56px;
                        clicked => { root.dismiss-details(); }
                        Text {
                            text: "×";
                            color: root.dark-mode ? #d4e5e5 : #425d63;
                            font-size: 30px;
                        }
                    }
                }

                Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: detail-body.preferred-height;
                    detail-body := VerticalLayout {
                        width: parent.width;
                        spacing: 14px;
                        Text {
                            text: root.details-data.name;
                            color: root.dark-mode ? #edf8f5 : #17323d;
                            font-size: 26px;
                            font-weight: 650;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 1px;
                            background: root.dark-mode ? #294b57 : #dce7e4;
                        }
                        Text {
                            text: root.details-data.value;
                            color: root.details-data.unavailable
                                ? (root.dark-mode ? #b1c3c7 : #657a80)
                                : (root.dark-mode ? #75e0c2 : #28796d);
                            font-size: 22px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                        if root.details-data.reason != "": Text {
                            text: root.details-data.reason;
                            color: root.dark-mode ? #ffc1b5 : #a73f35;
                            font-size: 15px;
                            wrap: word-wrap;
                        }
                        if root.details-data.update-time != "": VerticalLayout {
                            spacing: 5px;
                            Text {
                                text: root.german ? "Letzte Aktualisierung" : "Last updated";
                                color: root.dark-mode ? #9ab3ba : #566d73;
                                font-size: 12px;
                            }
                            Text {
                                text: root.details-data.update-time;
                                color: root.dark-mode ? #bdd3d4 : #415c63;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                        if root.details-data.attributes != "": VerticalLayout {
                            spacing: 5px;
                            Text {
                                text: root.german ? "Weitere Werte" : "Other values";
                                color: root.dark-mode ? #9ab3ba : #566d73;
                                font-size: 12px;
                            }
                            Text {
                                text: root.details-data.attributes;
                                color: root.dark-mode ? #bdd3d4 : #415c63;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                Rectangle {
                    height: 54px;
                    border-radius: 17px;
                    background: root.dark-mode ? #234b57 : #e5f3ee;
                    Text {
                        text: root.german ? "Fertig" : "Done";
                        color: root.dark-mode ? #dff6ef : #28675c;
                        font-size: 16px;
                        font-weight: 650;
                    }
                    TouchArea {
                        clicked => { root.dismiss-details(); }
                    }
                }
            }
        }
    }

    if !boot-screen && (inspect-status || command-warning): Rectangle {
        x: parent.width - self.width - 14px;
        y: root.landscape ? 76px : 66px;
        width: min(parent.width - 28px, message.preferred-width + 24px);
        height: 36px;
        background: root.dark-mode ? #234b57 : #e3eeea;
        border-radius: 8px;
        message := Text {
            text: root.connection-text;
            color: root.dark-mode ? #edf8f5 : #17323d;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if !boot-screen && show-clock: Rectangle {
        background: #07131b;
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            Text {
                text: root.clock-time;
                color: #edf8f5;
                font-size: root.landscape ? 92px : 82px;
                font-weight: 300;
                horizontal-alignment: center;
            }
            Text {
                text: root.german ? "Ortszeit" : "Local time";
                color: #83a0a6;
                font-size: 15px;
                letter-spacing: 2px;
                horizontal-alignment: center;
            }
        }
    }
    if !boot-screen && display-off: Rectangle {
        background: #000000;
    }
    if !boot-screen && display-dim-opacity > 0: Rectangle {
        background: #000000;
        opacity: root.display-dim-opacity;
    }
    if !boot-screen && (display-off || show-clock): Rectangle {
        background: #00000000;
        TouchArea {
            clicked => { root.wake-display(); }
        }
    }
}
